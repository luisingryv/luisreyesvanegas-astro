{
  "ci": {
    "collect": {
      "startServerCommand": "HOST=127.0.0.1 PORT=4399 node dist/server/entry.mjs",
      "startServerReadyPattern": "Server listening",
      "url": [
        "http://127.0.0.1:4399/es",
        "http://127.0.0.1:4399/es/sobre-mi",
        "http://127.0.0.1:4399/es/contacto",
        "http://127.0.0.1:4399/es/legal/privacidad"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
