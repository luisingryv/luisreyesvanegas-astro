---
// Insignia hexagonal de la pieza 09. Íconos propios: no son logos de terceros.
import type { Certificacion } from '../../lib/content';

interface Props {
  id: string;
  insignia: Certificacion['insignia'];
  obtained: boolean;
}

const { id, insignia, obtained } = Astro.props;
const hex = 'M50 4 L94 29 L94 81 L50 106 L6 81 L6 29 Z';
const clipId = `hex-${id}`;
---

<svg viewBox="0 0 100 110" class="badge-hex size-full overflow-visible" data-obtained={obtained}>
  <defs>
    <clipPath id={clipId}><path d={hex}></path></clipPath>
  </defs>
  <path class="fill-white" d={hex}></path>
  <g clip-path={`url(#${clipId})`}>
    <!-- Nivel de llenado: completo si está obtenida, a la mitad si está en proceso. -->
    <g data-fill transform={`translate(0 ${obtained ? 0 : 55})`}>
      <path
        class="wave"
        d="M-10 0 Q 2.5 -6 15 0 T 40 0 T 65 0 T 90 0 T 115 0 T 140 0 T 165 0 V 2 H -10 Z"></path>
      <rect x="-10" y="0" width="220" height="130"></rect>
    </g>
    <g transform="rotate(20 50 55)">
      <rect class="fill-white" x="-40" y="-20" width="22" height="150" opacity="0" data-shine
      ></rect>
    </g>
  </g>
  <path class="hex-outline" d={hex}></path>
  <g class="glyph">
    {
      insignia === 'ia' && (
        <path class="solid" d="M50 36 L55 51 L70 56 L55 61 L50 76 L45 61 L30 56 L45 51 Z" />
      )
    }
    {
      insignia === 'liderazgo' && (
        <>
          <circle cx="50" cy="46" r="9" />
          <path d="M32 76 C34 63 66 63 68 76" />
        </>
      )
    }
    {
      insignia === 'oratoria' && (
        <>
          <rect x="42" y="34" width="16" height="26" rx="8" />
          <path d="M35 54 C35 72 65 72 65 54 M50 67 V77 M42 77 H58" />
        </>
      )
    }
    {
      insignia === 'formacion' && (
        <>
          <path d="M27 50 L50 40 L73 50 L50 60 Z" />
          <path d="M37 55 V66 C44 72 56 72 63 66 V55 M73 50 V62" />
        </>
      )
    }
    {
      insignia === 'cloud' && (
        <path d="M36 70 H65 A10 10 0 0 0 65 50 A14 14 0 0 0 38 46 A11 11 0 0 0 36 70 Z" />
      )
    }
    {
      insignia === 'idioma' && (
        <path d="M30 40 H70 A6 6 0 0 1 76 46 V62 A6 6 0 0 1 70 68 H48 L38 76 V68 H30 A6 6 0 0 1 24 62 V46 A6 6 0 0 1 30 40 Z M36 52 H64 M36 58 H56" />
      )
    }
  </g>
</svg>

<style>
  .badge-hex [data-fill] path,
  .badge-hex [data-fill] rect {
    fill: var(--color-primary);
  }
  .badge-hex[data-obtained='false'] [data-fill] path,
  .badge-hex[data-obtained='false'] [data-fill] rect {
    fill: color-mix(in oklab, var(--color-primary) 26%, transparent);
  }
  .hex-outline {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 3;
  }
  .badge-hex[data-obtained='false'] .hex-outline {
    stroke-dasharray: 7 6;
  }
  .glyph {
    fill: none;
    stroke: var(--color-on-primary);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .glyph .solid {
    fill: var(--color-on-primary);
    stroke: none;
  }
  .badge-hex[data-obtained='false'] .glyph {
    stroke: var(--color-primary);
  }
  .badge-hex[data-obtained='false'] .glyph .solid {
    fill: var(--color-primary);
  }
  /* La ola solo se mueve en las insignias en proceso, y se pausa fuera de pantalla. */
  .badge-hex[data-obtained='false'] .wave {
    animation: wave 2.6s linear infinite;
  }
  :global([data-badges-paused]) .wave {
    animation-play-state: paused;
  }
  @keyframes wave {
    to {
      transform: translateX(-50px);
    }
  }
</style>
