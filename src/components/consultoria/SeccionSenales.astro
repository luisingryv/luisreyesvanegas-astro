---
import Section from '../brand/Section.astro';

interface Props {
  titulo: string;
  items: string[];
}

const { titulo, items } = Astro.props;
---

<Section
  tone="light-raised"
  class="py-[clamp(48px,6vw,80px)]!"
  reveal
  aria-labelledby="senales-titulo"
>
  <div class="flex flex-col gap-6">
    <h2 id="senales-titulo" class="text-heading font-bold">
      {titulo}
    </h2>
    <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-3">
      {items.map((item) => (
        <li class="rounded-md bg-surface p-5 font-bold">{item}</li>
      ))}
    </ul>
  </div>
</Section>
