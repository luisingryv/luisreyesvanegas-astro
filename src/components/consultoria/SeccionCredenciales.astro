---
import Eyebrow from '../brand/Eyebrow.astro';
import Section from '../brand/Section.astro';
import type { PaginaConsultoria } from '../../lib/content';

interface Props {
  credenciales: PaginaConsultoria['credenciales'];
  noSoyParaTi: PaginaConsultoria['noSoyParaTi'];
}

const { credenciales, noSoyParaTi } = Astro.props;
---

<Section tone="light-raised" spacing="section" aria-labelledby="credenciales-titulo">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-10">
    <div class="flex min-w-0 flex-col gap-4">
      <Eyebrow>{credenciales.eyebrow}</Eyebrow>
      <h2 id="credenciales-titulo" class="text-heading font-bold">
        {credenciales.titulo}
      </h2>
      <ul class="flex flex-wrap gap-2">
        {credenciales.items.map((c) => (
          <li class="rounded-pill border border-blue-300 bg-surface px-3.5 py-2.25 text-small font-bold">
            {c}
          </li>
        ))}
      </ul>
    </div>
    <div class="flex min-w-0 flex-col gap-4">
      <Eyebrow>{noSoyParaTi.eyebrow}</Eyebrow>
      <h2 class="text-heading font-bold">{noSoyParaTi.titulo}</h2>
      <ul class="flex flex-col gap-2.5 text-[17px]">
        {noSoyParaTi.items.map((item) => (
          <li class="border-t border-blue-300 pt-2.5">{item}</li>
        ))}
      </ul>
    </div>
  </div>
</Section>
