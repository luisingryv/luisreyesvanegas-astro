---
import Section from '../brand/Section.astro';
import SectionHeader from '../brand/SectionHeader.astro';
import TarjetaPuerta from './TarjetaPuerta.astro';
import type { PublishedLocale } from '../../i18n/config';
import type { PaginaConsultoria, Puerta } from '../../lib/content';

interface Props {
  locale: PublishedLocale;
  content: PaginaConsultoria['puertas'];
  puertas: Puerta[];
}

const { locale, content, puertas } = Astro.props;
---

<Section tone="light" aria-labelledby="puertas-titulo">
  <SectionHeader id="puertas-titulo" eyebrow={content.eyebrow} title={content.titulo} />
  <ul
    class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-4 [perspective:1000px]"
    data-misiones
  >
    {puertas.map((puerta) => (
      <li class="grid">
        <TarjetaPuerta
          locale={locale}
          puerta={puerta}
          total={puertas.length}
          boton={content.boton}
        />
      </li>
    ))}
  </ul>
</Section>

<script>
  import { iniciarMisiones } from '../motion/misiones';

  for (const lista of document.querySelectorAll<HTMLElement>('[data-misiones]')) {
    iniciarMisiones(lista);
  }
</script>
