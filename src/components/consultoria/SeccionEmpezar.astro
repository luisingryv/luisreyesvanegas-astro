---
// Cómo empezar: texto a la izquierda y una tarjeta aparte (programa MAP, llamada de 20 minutos
// o EvolutecC) a la derecha.
import Flecha from '../brand/Flecha.astro';
import Eyebrow from '../brand/Eyebrow.astro';
import Section from '../brand/Section.astro';
import type { PublishedLocale } from '../../i18n/config';
import type { Servicio } from '../../lib/content';
import { resolverEnlace } from '../../lib/enlaces';

interface Props {
  locale: PublishedLocale;
  content: Servicio['empezar'];
}

const { locale, content } = Astro.props;
const { aparte } = content;
const { href, external } = resolverEnlace(locale, aparte.enlace.destino);
---

<Section tone="light" class="py-[clamp(48px,6vw,80px)]!" reveal aria-labelledby="empezar-titulo">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-10">
    <div class="flex min-w-0 flex-col gap-3">
      <Eyebrow>{content.eyebrow}</Eyebrow>
      <h2 id="empezar-titulo" class="text-heading font-bold">
        {content.titulo}
      </h2>
      <p class="text-ink-muted">{content.texto}</p>
    </div>
    <aside
      class="flex min-w-0 flex-col gap-3 rounded-lg border border-primary p-6"
      aria-label={aparte.titulo}
    >
      <Eyebrow as="span">{aparte.eyebrow}</Eyebrow>
      <p class="text-[20px] font-bold">{aparte.titulo}</p>
      <p class="text-ink-muted">{aparte.texto}</p>
      <a href={href} class="self-start font-bold text-link hover:underline">
        {aparte.enlace.texto}
        <Flecha externa={external} />
      </a>
    </aside>
  </div>
</Section>
