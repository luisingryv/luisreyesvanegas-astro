---
// Hero claro de Consultoría y sus subpáginas: volver (opcional), eyebrow, título, texto y los
// dos botones de agenda.
import Button from '../brand/Button.astro';
import Eyebrow from '../brand/Eyebrow.astro';
import Section from '../brand/Section.astro';
import { bookingUrl } from '../../config/site';
import type { PublishedLocale } from '../../i18n/config';

interface Props {
  locale: PublishedLocale;
  volver?: { texto: string; href: string };
  eyebrow: string;
  titulo: string;
  texto: string;
  agendar: string;
  llamada: string;
  /** Consultoría lleva un título un poco más grande y corto. */
  principal?: boolean;
}

const { locale, volver, eyebrow, titulo, texto, agendar, llamada, principal = false } = Astro.props;
const agenda = bookingUrl(locale);
---

<Section
  tone="light"
  spacing="hero"
  class="pb-[clamp(40px,5vw,64px)]!"
  aria-labelledby="hero-titulo"
>
  <div class="flex flex-col gap-5">
    {volver && (
      <a href={volver.href} class="self-start text-small font-bold text-link hover:underline">
        <span aria-hidden="true">←</span> {volver.texto}
      </a>
    )}
    <Eyebrow>{eyebrow}</Eyebrow>
    <h1
      id="hero-titulo"
      class:list={[
        'font-bold text-balance',
        principal
          ? 'max-w-[16ch] text-[clamp(38px,5.4vw,72px)] leading-[1.02] tracking-[-0.02em]'
          : 'max-w-[20ch] text-display',
      ]}
    >
      {titulo}
    </h1>
    <p class="max-w-[66ch] text-lead text-ink-muted">{texto}</p>
    <div class="flex flex-wrap gap-3 pt-1.5">
      <Button href={agenda} size="lg">
        {agendar}
      </Button>
      <Button href={agenda} size="lg" variant="outline">
        {llamada}
      </Button>
    </div>
  </div>
</Section>
