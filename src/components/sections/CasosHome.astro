---
// Pieza 08 · Casos como burbujas. Desde el 22 nov 2026 llevan el logo a color del cliente (Luis
// entregó los logos); el nombre queda para lectores de pantalla y como respaldo si falta el logo.
// Cada burbuja enlaza a su caso o al índice de casos.
import Flecha from '../brand/Flecha.astro';
import { Image } from 'astro:assets';
import Section from '../brand/Section.astro';
import SectionHeader from '../brand/SectionHeader.astro';
import type { PublishedLocale } from '../../i18n/config';
import { localizedPath } from '../../i18n/routes';
import type { PaginaHome } from '../../lib/content';

interface Props {
  locale: PublishedLocale;
  content: PaginaHome['casos'];
}

const { locale, content } = Astro.props;
const indice = localizedPath(locale, 'casos');
---

<Section tone="light" id="casos" class="relative" aria-labelledby="casos-titulo">
  <canvas
    class="pointer-events-none absolute inset-x-0 top-0 h-(--spacing-section-y) w-full"
    aria-hidden="true"
    data-particulas
  ></canvas>
  <SectionHeader id="casos-titulo" eyebrow={content.eyebrow} title={content.titulo}>
    <a slot="action" href={indice} class="font-bold text-link hover:underline">
      {content.verTodos}
      <Flecha />
    </a>
  </SectionHeader>
  <div
    class="relative grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] gap-8"
    data-casos
  >
    {content.grupos.map((grupo) => (
      <div class="flex min-w-0 flex-col gap-4">
        <h3 class="text-[17px] font-bold">{grupo.titulo}</h3>
        <ul class="flex flex-wrap gap-x-5.5 gap-y-4.5 px-1.5 pt-3.5 pb-5.5">
          {grupo.casos.map((caso) => (
            <li>
              <a
                href={caso.slug ? `${indice}/${caso.slug}` : indice}
                class="burbuja block rounded-full text-ink"
                data-burbuja
              >
                <span
                  class:list={[
                    'burbuja-interior relative grid size-[clamp(108px,11vw,128px)] place-items-center rounded-full border-[1.5px] border-blue-300 p-3.5 text-center text-small leading-tight font-bold',
                    grupo.destacado ? 'bg-surface-raised' : 'bg-surface',
                  ]}
                >
                  {caso.logo ? (
                    <span class="flex flex-col items-center gap-1.5">
                      <Image
                        src={caso.logo}
                        alt=""
                        height={44}
                        densities={[1, 2]}
                        class="logo h-auto max-h-11 w-20 object-contain"
                      />
                      {caso.pie && (
                        <span aria-hidden="true" class="text-[11px] leading-none text-ink-muted">
                          {caso.pie}
                        </span>
                      )}
                      <span class="sr-only">{caso.nombre}</span>
                    </span>
                  ) : (
                    caso.nombre
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <div
      class="burbujas-estallido pointer-events-none absolute inset-0"
      aria-hidden="true"
      data-estallido
    ></div>
  </div>
</Section>

<style>
  /* Brillo de burbuja de jabón. */
  .burbuja-interior::before {
    content: '';
    position: absolute;
    left: 20%;
    top: 11%;
    width: 30%;
    height: 16%;
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-white) 85%, transparent);
    transform: rotate(-24deg);
    pointer-events: none;
  }

  .burbuja-interior {
    transition:
      border-color 250ms ease,
      box-shadow 250ms ease;
  }

  .burbuja:hover .burbuja-interior,
  .burbuja:focus-visible .burbuja-interior {
    border-color: var(--color-primary);
    box-shadow:
      0 0 0 6px color-mix(in oklab, var(--color-primary) 14%, transparent),
      0 16px 34px -18px var(--color-primary);
  }

  .burbuja {
    will-change: transform;
  }

  .burbujas-estallido :global(i) {
    position: absolute;
    width: 7px;
    height: 7px;
    margin: -3.5px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .burbujas-estallido :global(i:nth-child(3n)) {
    background: var(--color-blue-300);
  }

  .burbujas-estallido :global(i:nth-child(4n)) {
    width: 4px;
    height: 4px;
    margin: -2px;
  }
</style>

<script>
  import { iniciarBurbujas } from '../motion/burbujas';
  import { iniciarParticulas } from '../motion/particulas';

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-particulas]')) {
    iniciarParticulas(canvas);
  }

  for (const campo of document.querySelectorAll<HTMLElement>('[data-casos]')) {
    iniciarBurbujas(campo);
  }
</script>
