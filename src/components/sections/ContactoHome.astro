---
// Cierre del Home: texto a la izquierda y formulario general a la derecha (sin logo 3D,
// decisión de Luis del 20 nov 2026). id="agenda" como en el prototipo.
import Eyebrow from '../brand/Eyebrow.astro';
import Section from '../brand/Section.astro';
import { FormularioContacto } from '../formularios/FormularioContacto';
import type { PublishedLocale } from '../../i18n/config';
import { localizedPath } from '../../i18n/routes';
import type { PaginaHome } from '../../lib/content';

interface Props {
  locale: PublishedLocale;
  content: PaginaHome['contacto'];
  /** Número corporativo de WhatsApp; la línea no aparece mientras Luis no lo entregue. */
  whatsapp?: string;
}

const { locale, content, whatsapp } = Astro.props;
---

<Section tone="dark" id="agenda" aria-labelledby="contacto-titulo">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-12">
    <div class="flex min-w-0 flex-col gap-4">
      <Eyebrow>{content.eyebrow}</Eyebrow>
      <h2 id="contacto-titulo" class="text-heading-lg font-bold text-balance">
        {content.titulo}
      </h2>
      <p class="text-text-secondary-on-dark">{content.texto}</p>
      {whatsapp && (
        <p class="text-small text-blue-300">
          {content.whatsapp} {whatsapp}
        </p>
      )}
    </div>
    <FormularioContacto
      textos={{
        ...content.campos,
        temas: content.temas,
        autorizacion: content.autorizacion,
        enviar: content.enviar,
        enviado: content.enviado,
        error: content.error,
      }}
      idioma={locale}
      pagina={localizedPath(locale, 'home')}
      politicaHref={localizedPath(locale, 'legal')}
    />
  </div>
</Section>
