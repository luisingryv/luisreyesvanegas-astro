---
import Section from '../brand/Section.astro';
import SectionHeader from '../brand/SectionHeader.astro';
import LevelTimeline from '../motion/LevelTimeline.astro';
import type { PublishedLocale } from '../../i18n/config';
import type { FotoGaleria, Historia, PaginaSobreMi } from '../../lib/content';

interface Props {
  locale: PublishedLocale;
  content: PaginaSobreMi['historia'];
  historia: Historia;
  galerias?: Record<string, FotoGaleria[]>;
}

const { locale, content, historia, galerias } = Astro.props;
---

<Section tone="dark" aria-labelledby="historia-titulo">
  <SectionHeader id="historia-titulo" eyebrow={content.eyebrow} title={content.titulo} />
  <LevelTimeline
    locale={locale}
    historia={historia}
    galerias={galerias}
    cta={{ label: content.siguienteNivel, href: '#contacto' }}
  />
</Section>
