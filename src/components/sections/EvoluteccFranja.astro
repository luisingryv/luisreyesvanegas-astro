---
// Franja hacia EvolutecC (desarrollo a la medida), con UTM por página.
// 21 nov 2026 (Luis): con los colores de EvolutecC (azul y naranja de evolutecc.com) para que se
// distinga de las secciones oscuras sin una línea de división.
// 22 nov 2026 (Luis): como la sección de Nexa en Programas AWS. A la izquierda el antetítulo,
// el texto, las cifras públicas de evolutecc.com y el botón; a la derecha el logo de EvolutecC
// a color en una tarjeta blanca. Luis, su CTO, entregó el logo para el sitio.
import { Image } from 'astro:assets';
import logoEvolutecc from '../../assets/brand/evolutecc_color.jpg';
import BotonMarca from '../brand/BotonMarca.astro';
import Container from '../brand/Container.astro';
import { evoluteccUrl } from '../../config/site';
import type { PaginaHome } from '../../lib/content';

interface Props {
  content: PaginaHome['evolutecc'];
  campaign: string;
}

const { content, campaign } = Astro.props;
---

<section
  aria-labelledby="evolutecc-franja-titulo"
  class="franja relative overflow-hidden py-section-y text-white"
>
  <span class="barra absolute inset-x-0 top-0 h-1.5" aria-hidden="true"></span>
  <Container
    data-reveal
    class="relative grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-center gap-10"
  >
    <div class="flex min-w-0 flex-col gap-4">
      <span class="text-eyebrow font-bold text-white/80 uppercase">{content.eyebrow}</span>
      <h2
        id="evolutecc-franja-titulo"
        class="text-[clamp(28px,3.4vw,42px)] leading-[1.1] font-bold text-balance"
      >
        {content.titulo}
      </h2>
      <p class="max-w-[56ch] text-white/85">{content.texto}</p>
      <ul class="flex flex-wrap gap-2">
        {content.cifras.map((cifra) => (
          <li class="rounded-pill border border-white/55 px-3 py-1.75 text-[13px] font-bold">
            {cifra}
          </li>
        ))}
      </ul>
      <BotonMarca
        href={evoluteccUrl(campaign)}
        fondo="var(--color-evolutecc-orange-boton)"
        fondoHover="var(--color-evolutecc-orange-boton-hover)"
        class="mt-1 self-start"
      >
        {content.boton}
      </BotonMarca>
    </div>
    <div class="logo grid min-h-55 place-items-center self-stretch rounded-lg bg-white p-10">
      <Image
        src={logoEvolutecc}
        alt="EvolutecC"
        widths={[360, 720]}
        sizes="360px"
        class="h-auto w-full max-w-90"
      />
    </div>
  </Container>
</section>

<style>
  .franja {
    background:
      radial-gradient(
        70% 140% at 100% 0%,
        color-mix(in oklab, var(--color-evolutecc-orange) 28%, transparent),
        transparent 60%
      ),
      linear-gradient(120deg, var(--color-evolutecc-blue) 0%, var(--color-evolutecc-blue-deep) 100%);
  }
  .barra {
    background: linear-gradient(90deg, var(--color-evolutecc-blue), var(--color-evolutecc-orange));
    filter: brightness(1.15);
  }
  .logo {
    box-shadow: 0 24px 60px color-mix(in oklab, var(--color-evolutecc-night) 35%, transparent);
  }
</style>
