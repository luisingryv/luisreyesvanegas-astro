---
import Section from '../brand/Section.astro';
import SectionHeader from '../brand/SectionHeader.astro';
import CollectibleBadges from '../motion/CollectibleBadges.astro';
import type { PublishedLocale } from '../../i18n/config';
import type { Certificacion, PaginaSobreMi } from '../../lib/content';

interface Props {
  locale: PublishedLocale;
  content: PaginaSobreMi['certificaciones'];
  certificaciones: Certificacion[];
}

const { locale, content, certificaciones } = Astro.props;
---

<Section tone="light" aria-labelledby="certificaciones-titulo">
  <SectionHeader id="certificaciones-titulo" eyebrow={content.eyebrow} title={content.titulo} />
  <CollectibleBadges locale={locale} certificaciones={certificaciones} />
</Section>
