---
// Bloque del XPRIZE con la pieza 01 en lugar de las tres cajas del prototipo (MOTION-DEL-SITIO).
// Las cifras van también en texto.
import Button from '../brand/Button.astro';
import Eyebrow from '../brand/Eyebrow.astro';
import Section from '../brand/Section.astro';
import XprizeField from '../motion/XprizeField.astro';
import type { PublishedLocale } from '../../i18n/config';
import { localizedPath } from '../../i18n/routes';
import type { PaginaHome } from '../../lib/content';

interface Props {
  locale: PublishedLocale;
  content: PaginaHome['xprize'];
}

const { locale, content } = Astro.props;
---

<Section tone="dark" reveal aria-labelledby="xprize-titulo">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] items-center gap-8 rounded-lg border border-accent bg-surface-raised p-[clamp(28px,4vw,56px)]">
    <div class="flex min-w-0 flex-col gap-4">
      <Eyebrow>{content.eyebrow}</Eyebrow>
      <h2 id="xprize-titulo" class="text-heading font-bold text-balance">
        {content.titulo}
      </h2>
      <p class="text-text-secondary-on-dark">{content.texto}</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <Button href={localizedPath(locale, 'productos')} variant="highlight" size="md">
          {content.boton}
        </Button>
        <a href={content.fuente.url} class="font-bold text-link underline underline-offset-4">
          {content.fuente.texto}
        </a>
      </div>
    </div>
    <div class="min-w-0">
      <XprizeField textos={content.pieza} />
      <!-- Las cifras, en texto para lectores de pantalla; la pieza las muestra animadas. -->
      <dl class="sr-only" data-xprize>
        {content.cifras.map((cifra) => (
          <div>
            <dt>{cifra.etiqueta}</dt>
            <dd>{cifra.valor}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</Section>
