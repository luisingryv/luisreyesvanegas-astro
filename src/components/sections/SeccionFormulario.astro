---
// Sección con texto a la izquierda y el formulario general a la derecha. La usan el Home
// (#agenda, sobre night) y Contacto (#general, sobre blue-800 con la tarjeta en night).
// El WhatsApp ya no va aquí: es el botón flotante de todas las páginas (Luis, 27 nov 2026).
import Eyebrow from '../brand/Eyebrow.astro';
import Section from '../brand/Section.astro';
import { FormularioContacto } from '../formularios/FormularioContacto';
import { getDictionary } from '../../i18n';
import type { PublishedLocale } from '../../i18n/config';
import { localizedPath, type RouteKey } from '../../i18n/routes';
import type { FormularioGeneral } from '../../lib/content';

interface Props {
  locale: PublishedLocale;
  id: string;
  /** Ruta de la página, para volver a ella al enviar sin JavaScript. */
  ruta: RouteKey;
  tono?: 'dark' | 'dark-raised';
  eyebrow: string;
  titulo: string;
  texto?: string;
  tema: string;
  temas: { valor: string; texto: string }[];
  comunes: FormularioGeneral;
  filasMensaje?: number;
}

const {
  locale,
  id,
  ruta,
  tono = 'dark',
  eyebrow,
  titulo,
  texto,
  tema,
  temas,
  comunes,
  filasMensaje,
} = Astro.props;
const t = getDictionary(locale);
const tituloId = `${id}-titulo`;
---

<Section tone={tono} id={id} aria-labelledby={tituloId}>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-12">
    <div class="flex min-w-0 flex-col gap-4">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 id={tituloId} class="text-heading-lg font-bold text-balance">
        {titulo}
      </h2>
      {texto && <p class="text-text-secondary-on-dark">{texto}</p>}
    </div>
    <FormularioContacto
      contacto={comunes.campos}
      textos={{
        nombre: comunes.campos.nombre,
        correo: comunes.campos.correo,
        mensaje: comunes.campos.mensaje,
        tema,
        temas,
        autorizacion: comunes.autorizacion,
        enviar: comunes.enviar,
        enviado: comunes.enviado,
        error: comunes.error,
      }}
      mensajes={t.formulario}
      idioma={locale}
      pagina={localizedPath(locale, ruta)}
      politicaHref={localizedPath(locale, 'privacidad')}
      variante={tono === 'dark-raised' ? 'base' : 'raised'}
      filasMensaje={filasMensaje}
    />
  </div>
</Section>

<script>
  import { mejorarFormulario } from '../formularios/formulario';

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-formulario]')) {
    mejorarFormulario(form);
  }
</script>
