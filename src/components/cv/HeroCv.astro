---
// Hero del CV (rediagramado el 19 nov 2026): texto, botones y los cuatro datos en dos columnas con
// línea fina superior, sin caja; a la derecha, el retrato 4:5 a todo el ancho de la columna.
// "Download CV (EN)" no se publica hasta que Luis apruebe el CV en inglés.
import Flecha from '../brand/Flecha.astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../brand/Button.astro';
import Eyebrow from '../brand/Eyebrow.astro';
import Section from '../brand/Section.astro';
import type { PaginaCv } from '../../lib/content';

interface Props {
  textos: PaginaCv['hero'];
  foto: ImageMetadata;
  pdfHref: string;
  linkedin: string;
}

const { textos, foto, pdfHref, linkedin } = Astro.props;
---

<Section
  tone="light"
  id="descargar"
  class="py-[clamp(40px,6vw,80px)]! pb-[clamp(40px,5vw,64px)]!"
  aria-labelledby="cv-titulo"
>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-center gap-12">
    <div class="flex min-w-0 flex-col gap-4">
      <Eyebrow>{textos.eyebrow}</Eyebrow>
      <h1
        id="cv-titulo"
        class="text-[clamp(36px,4.6vw,58px)] leading-[1.05] font-bold tracking-[-0.02em]"
      >
        {textos.titulo}
      </h1>
      <p class="max-w-[56ch] text-[18px] text-ink-muted">{textos.texto}</p>
      <div class="cv-acciones flex flex-wrap gap-3 pt-1.5">
        <Button href={pdfHref} download>
          {textos.descargar}
        </Button>
        <Button href="#entrevista" variant="outline">
          {textos.entrevista}
        </Button>
        <a href={linkedin} target="_blank" rel="noopener" class="px-1 py-3.75 font-bold text-link">
          {textos.linkedin}
          <Flecha externa />
        </a>
      </div>
      <dl class="mt-4 grid grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-x-8 text-[15px] leading-[1.45]">
        {textos.datos.map((dato) => (
          <div class="border-t border-line-on-light py-4">
            <dt class="mb-1 text-[11px] font-bold tracking-[0.12em] text-link uppercase">
              {dato.clave}
            </dt>
            <dd>
              {dato.valor}
              {dato.fuente && (
                <>
                  {' ('}
                  <a
                    href={dato.fuente.url}
                    target="_blank"
                    rel="noopener"
                    class="text-link underline underline-offset-2"
                  >
                    {dato.fuente.texto}
                  </a>
                  {')'}
                </>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
    <Image
      src={foto}
      alt={textos.fotoAlt}
      widths={[480, 720, 976]}
      sizes="(min-width: 1024px) 560px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="cv-retrato aspect-4/5 w-full rounded-lg object-cover object-top"
    />
  </div>
</Section>
