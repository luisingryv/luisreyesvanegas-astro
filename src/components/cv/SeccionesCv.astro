---
// Secciones del CV tal cual el prototipo: logros con cifra y fuente, experiencia, stack y
// competencias (pieza 12) con formación y certificaciones, y charlas y comunidad. Las
// recomendaciones de ejemplo no se publican.
// 21 nov 2026 (Luis): los logros usan el mismo motion del Home (pieza 02, en claro) y la
// formación y certificaciones, las insignias coleccionables de Sobre mí (pieza 09).
import AchievementCard from '../brand/AchievementCard.astro';
import Section from '../brand/Section.astro';
import CollectibleBadges from '../motion/CollectibleBadges.astro';
import CompetenciasCv from './CompetenciasCv.astro';
import type { PublishedLocale } from '../../i18n/config';
import { getDictionary } from '../../i18n';
import type { Certificacion, Logro, PaginaCv } from '../../lib/content';

interface Props {
  locale: PublishedLocale;
  textos: PaginaCv;
  certificaciones: Certificacion[];
  sobreMiHref: string;
  eventosHref: string;
}

const { locale, textos, certificaciones, sobreMiHref, eventosHref } = Astro.props;
const t = getDictionary(locale);
const h2 = 'text-[clamp(26px,3vw,36px)] leading-[1.15] font-bold';
const logros: Logro[] = textos.logros.lista.map((l, i) => ({
  id: `cv-${i + 1}`,
  metrica: l.metrica,
  descripcion: l.texto,
  quien: l.quien,
}));
---

<Section tone="light" class="py-[clamp(48px,6vw,80px)]!" aria-labelledby="logros-titulo" reveal>
  <div class="flex flex-col gap-6">
    <h2 id="logros-titulo" class={h2}>
      {textos.logros.titulo}
    </h2>
    <ol class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3.5" data-logros>
      {logros.map((logro) => (
        <AchievementCard logro={logro} as="li" tono="claro" bloqueado={t.logros.bloqueado} />
      ))}
    </ol>
  </div>
</Section>

<Section
  tone="light"
  class="bg-blue-100! py-[clamp(48px,6vw,80px)]!"
  aria-labelledby="experiencia-titulo"
  reveal
>
  <div class="flex flex-col gap-6">
    <h2 id="experiencia-titulo" class={h2}>
      {textos.experiencia.titulo}
    </h2>
    <ol>
      {textos.experiencia.lista.map((puesto) => (
        <li class="experiencia grid grid-cols-[minmax(110px,160px)_minmax(0,1fr)] gap-x-6 gap-y-2 border-t border-blue-300 py-5">
          <span class="text-[14px] font-bold text-blue-600">{puesto.anios}</span>
          <div class="flex min-w-0 flex-col gap-1">
            <h3 class="text-[18px] font-bold">{puesto.rol}</h3>
            <span class="text-[15px] font-bold text-link">{puesto.org}</span>
            <p class="text-[15px] text-ink-muted">{puesto.texto}</p>
          </div>
        </li>
      ))}
    </ol>
    <a href={sobreMiHref} class="self-start font-bold text-link hover:underline">
      {textos.experiencia.historia} <span aria-hidden="true">→</span>
    </a>
  </div>
</Section>

<Section tone="light" class="py-[clamp(48px,6vw,80px)]!" aria-labelledby="stack-titulo">
  <div class="flex flex-col gap-12">
    <div class="flex flex-col gap-4">
      <h2 id="stack-titulo" class={h2}>
        {textos.competencias.titulo}
      </h2>
      <CompetenciasCv textos={textos.competencias} />
    </div>
    <div class="flex flex-col gap-4">
      <h2 class={h2}>{textos.formacion.titulo}</h2>
      <CollectibleBadges locale={locale} certificaciones={certificaciones} />
    </div>
  </div>
</Section>

<Section
  tone="light"
  class="bg-blue-100! py-[clamp(48px,6vw,80px)]!"
  aria-labelledby="comunidad-titulo"
  reveal
>
  <div class="flex max-w-[64ch] flex-col gap-3.5">
    <h2 id="comunidad-titulo" class={h2}>
      {textos.comunidad.titulo}
    </h2>
    <p class="text-ink-muted">{textos.comunidad.texto}</p>
    <a href={eventosHref} class="self-start font-bold text-link hover:underline">
      {textos.comunidad.enlace} <span aria-hidden="true">→</span>
    </a>
  </div>
</Section>

<script>
  import { iniciarLogros } from '../motion/logros';

  for (const lista of document.querySelectorAll<HTMLElement>('[data-logros]')) {
    iniciarLogros(lista);
  }
</script>
