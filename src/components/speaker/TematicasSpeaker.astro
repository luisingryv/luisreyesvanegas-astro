---
// Temáticas: cinta en dos filas que se mueven en sentidos contrarios, se detiene al pasar el
// cursor y queda quieta (en varias líneas) con "reducir movimiento" (Luis, 17 nov 2026). Para
// cumplir WCAG 2.2.2 también hay un botón que la pausa (teclado y pantallas táctiles; por
// aprobar). Cada fila se repite una vez, oculta para lectores de pantalla, para que el giro sea
// continuo. Debajo, los tres pasos para preparar la charla.
import Eyebrow from '../brand/Eyebrow.astro';
import Section from '../brand/Section.astro';
import type { PaginaSpeaker } from '../../lib/content';

interface Props {
  textos: PaginaSpeaker['tematicas'];
  pausar: string;
}

const { textos, pausar } = Astro.props;
const filas = [
  { temas: textos.filaA, clase: 'tema-a', sentido: 'izquierda' },
  { temas: textos.filaB, clase: 'tema-b', sentido: 'derecha' },
] as const;
---

<Section tone="dark-raised" aria-labelledby="tematicas-titulo">
  <div class="flex flex-col gap-7">
    <div class="flex flex-col gap-2.5">
      <Eyebrow>{textos.eyebrow}</Eyebrow>
      <h2 id="tematicas-titulo" class="text-heading font-bold text-balance">
        {textos.titulo}
      </h2>
      <p class="max-w-[64ch] text-text-secondary-on-dark">{textos.texto}</p>
    </div>
    <div class="flex flex-col gap-3.5" data-cintas>
      <button type="button" class="cinta-control self-end" aria-pressed="false" data-pausar-cinta>
        {pausar}
      </button>
      {filas.map((fila) => (
        <div class="cinta">
          <div class:list={['cinta-pista', fila.sentido === 'derecha' && 'cinta-derecha']}>
            <ul class="cinta-grupo">
              {fila.temas.map((tema) => (
                <li class:list={['tema', fila.clase]}>{tema}</li>
              ))}
            </ul>
            <ul class="cinta-grupo cinta-copia" aria-hidden="true">
              {fila.temas.map((tema) => (
                <li class:list={['tema', fila.clase]}>{tema}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
    <ol class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-4">
      {textos.pasos.map((paso, i) => (
        <li class="grid grid-cols-[48px_minmax(0,1fr)] gap-3.5 rounded-md border border-hairline bg-surface p-5.5">
          <span
            class="grid size-10 place-items-center rounded-xl border border-accent text-[14px] font-bold text-link"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="flex min-w-0 flex-col gap-1">
            <b class="text-[17px]">{paso.titulo}</b>
            <span class="text-[14px] text-text-secondary-on-dark">{paso.texto}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  .cinta {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .cinta-pista {
    display: flex;
    width: max-content;
    animation: cinta-izquierda 70s linear infinite;
  }

  .cinta-derecha {
    animation-name: cinta-derecha;
    animation-duration: 80s;
  }

  .cinta:hover .cinta-pista,
  [data-cintas]:has([aria-pressed='true']) .cinta-pista {
    animation-play-state: paused;
  }

  .cinta-control {
    border: 1px solid var(--color-gray-700);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text-secondary-on-dark);
  }

  .cinta-control[aria-pressed='true'] {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }

  .cinta-grupo {
    display: flex;
    gap: 12px;
    padding-right: 12px;
  }

  .tema {
    flex: none;
    padding: 14px 22px;
    border-radius: var(--radius-pill);
    font-size: clamp(16px, 1.6vw, 20px);
    font-weight: 700;
    white-space: nowrap;
  }

  .tema-a {
    border: 1px solid var(--color-accent);
    background: var(--color-night);
  }

  .tema-b {
    border: 1px solid var(--color-gray-700);
    background: var(--color-primary);
    color: var(--color-white);
  }

  @keyframes cinta-izquierda {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes cinta-derecha {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cinta {
      mask-image: none;
    }
    .cinta-pista {
      width: auto;
      animation: none;
    }
    .cinta-grupo {
      flex-wrap: wrap;
    }
    .cinta-copia,
    .cinta-control {
      display: none;
    }
  }
</style>

<script>
  for (const boton of document.querySelectorAll<HTMLButtonElement>('[data-pausar-cinta]')) {
    boton.addEventListener('click', () => {
      boton.setAttribute('aria-pressed', String(boton.getAttribute('aria-pressed') !== 'true'));
    });
  }
</script>
