---
// Hero de Charlas: texto, "Invitarme a hablar" y "Copiar mi bio", y la foto de Luis en escenario
// (en el prototipo era un espacio reservado; Luis, 20 nov 2026). La foto va completa, sin recortar,
// sobre la misma foto desenfocada.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../brand/Button.astro';
import Eyebrow from '../brand/Eyebrow.astro';
import Section from '../brand/Section.astro';

interface Props {
  eyebrow: string;
  titulo: string;
  texto: string;
  invitar: string;
  copiarBio: string;
  foto: ImageMetadata;
  fotoAlt: string;
}

const { eyebrow, titulo, texto, invitar, copiarBio, foto, fotoAlt } = Astro.props;
---

<Section tone="dark" spacing="hero" aria-labelledby="speaker-titulo">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,460px),1fr))] items-center gap-12 @container @max-[968px]:[&>:last-child]:order-first">
    <div class="flex min-w-0 flex-col gap-5.5">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h1
        id="speaker-titulo"
        class="text-[clamp(38px,5vw,64px)] leading-[1.04] font-bold tracking-[-0.02em] text-balance"
      >
        {titulo}
      </h1>
      <p class="max-w-[54ch] text-[clamp(17px,1.6vw,20px)] leading-[1.55] text-text-secondary-on-dark">
        {texto}
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <Button href="#invitar" size="lg">
          {invitar}
        </Button>
        <Button href="#bio" size="lg" variant="secondary">
          {copiarBio}
        </Button>
      </div>
    </div>
    <div class="relative aspect-4/5 max-h-150 w-full overflow-hidden rounded-lg bg-surface-raised">
      <Image
        src={foto}
        alt=""
        width={48}
        loading="eager"
        class="absolute inset-0 size-full scale-125 object-cover blur-2xl brightness-45"
      />
      <Image
        src={foto}
        alt={fotoAlt}
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 560px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="relative size-full object-contain"
      />
    </div>
  </div>
</Section>
