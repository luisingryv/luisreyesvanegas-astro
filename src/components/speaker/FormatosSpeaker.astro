---
// Formatos (cómo puedo participar, honorarios sin cifras) y rider técnico. El botón "Descargar
// one-sheet (PDF)" no se publica hasta que exista el PDF.
import Eyebrow from '../brand/Eyebrow.astro';
import Section from '../brand/Section.astro';
import type { PaginaSpeaker } from '../../lib/content';

interface Props {
  textos: PaginaSpeaker['formatos'];
}

const { textos } = Astro.props;
---

<Section tone="dark" aria-labelledby="formatos-titulo">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-10">
    <div class="flex min-w-0 flex-col gap-4">
      <Eyebrow>{textos.eyebrow}</Eyebrow>
      <h2 id="formatos-titulo" class="text-[clamp(26px,3vw,36px)] leading-[1.15] font-bold">
        {textos.titulo}
      </h2>
      <dl class="flex flex-col gap-4">
        {textos.lista.map((formato) => (
          <div class="flex flex-col gap-1 border-t border-hairline pt-3">
            <dt class="text-[18px] font-bold">{formato.nombre}</dt>
            <dd class="text-[15px] text-text-secondary-on-dark">{formato.texto}</dd>
          </div>
        ))}
      </dl>
      <p class="text-[15px] text-text-tertiary-on-dark">{textos.honorarios}</p>
    </div>
    <div class="flex min-w-0 flex-col gap-4">
      <Eyebrow>{textos.riderEyebrow}</Eyebrow>
      <h2 class="text-[clamp(26px,3vw,36px)] leading-[1.15] font-bold">{textos.riderTitulo}</h2>
      <ul class="flex flex-col gap-2.5">
        {textos.rider.map((item) => (
          <li class="border-t border-hairline pt-2.5">{item}</li>
        ))}
      </ul>
    </div>
  </div>
</Section>
