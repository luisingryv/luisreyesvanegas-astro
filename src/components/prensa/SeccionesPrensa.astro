---
// Prensa: kit de prensa (hero con datos rápidos), fotos oficiales, logos, datos del XPRIZE y la
// descarga del kit completo. La bio y el formulario son componentes aparte.
import { Image } from 'astro:assets';
import iconBlancoPng from '../../assets/brand/icon-b.png';
import iconBlancoSvg from '../../assets/brand/icon-b.svg';
import iconPng from '../../assets/brand/icon.png';
import iconSvg from '../../assets/brand/icon.svg';
import blancoPng from '../../assets/brand/marca-h-color-blanco.png';
import blancoSvg from '../../assets/brand/marca-h-color-blanco.svg';
import colorPng from '../../assets/brand/marca-h-color.png';
import colorSvg from '../../assets/brand/marca-h-color.svg';
import Button from '../brand/Button.astro';
import Eyebrow from '../brand/Eyebrow.astro';
import Section from '../brand/Section.astro';
import type { PaginaPrensa } from '../../lib/content';
import { fotoPrensa } from '../../lib/kit-prensa';

interface Props {
  textos: PaginaPrensa;
  kitHref: string;
  seccion: 'hero' | 'fotos' | 'xprize';
}

const { textos, kitHref, seccion } = Astro.props;
const [logoBlanco, logoColor, monograma] = textos.logos.lista;
const descargas = (svg: { src: string }, png: { src: string }, nombre: string, alt: string) => [
  { href: png.src, archivo: `${nombre}.png`, formato: 'PNG', etiqueta: alt },
  { href: svg.src, archivo: `${nombre}.svg`, formato: 'SVG', etiqueta: alt },
];
const logos = [
  {
    ...logoBlanco!,
    imagen: blancoSvg,
    fondo: 'bg-night',
    archivos: descargas(blancoSvg, blancoPng, 'marca-h-color-blanco', logoBlanco!.alt),
  },
  {
    ...logoColor!,
    imagen: colorSvg,
    fondo: 'bg-white',
    archivos: descargas(colorSvg, colorPng, 'marca-h-color', logoColor!.alt),
  },
];
---

{seccion === 'hero' && (
  <Section tone="dark" spacing="hero" aria-labelledby="prensa-titulo">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-start gap-12">
      <div class="flex min-w-0 flex-col gap-5.5">
        <Eyebrow>{textos.hero.eyebrow}</Eyebrow>
        <h1
          id="prensa-titulo"
          class="text-[clamp(38px,5vw,64px)] leading-[1.04] font-bold tracking-[-0.02em]"
        >
          {textos.hero.titulo}
        </h1>
        <p class="max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-text-secondary-on-dark">
          {textos.hero.texto}
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <Button href={kitHref} size="lg" download>
            {textos.hero.descargar}
          </Button>
          <Button href="#contacto-prensa" size="lg" variant="secondary">
            {textos.hero.entrevista}
          </Button>
        </div>
      </div>
      <dl class="grid gap-0 rounded-lg border border-hairline bg-surface-raised p-6">
        {textos.hero.datos.map((dato, i) => (
          <div class:list={['grid gap-1 py-3.5', i > 0 && 'border-t border-hairline']}>
            <dt class="text-[11px] font-bold tracking-[0.12em] text-cyan-300 uppercase">
              {dato.clave}
            </dt>
            <dd class="font-bold">{dato.valor}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>
)}

{seccion === 'fotos' && (
  <>
    <Section tone="dark-raised" aria-labelledby="fotos-titulo">
      <div class="flex flex-col gap-7">
        <div class="flex flex-col gap-2.5">
          <Eyebrow>{textos.fotos.eyebrow}</Eyebrow>
          <h2 id="fotos-titulo" class="text-heading font-bold text-balance">
            {textos.fotos.titulo}
          </h2>
          <p class="max-w-[64ch] text-text-secondary-on-dark">{textos.fotos.texto}</p>
        </div>
        <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-4">
          {textos.fotos.lista.map((foto) => {
            const imagen = fotoPrensa(foto.archivo);
            return (
              <li
                class="flex min-w-0 flex-col overflow-hidden rounded-lg border border-hairline bg-surface"
                data-reveal
              >
                <div class="relative aspect-4/5 overflow-hidden bg-surface-raised">
                  <Image
                    src={imagen}
                    alt=""
                    width={48}
                    class="absolute inset-0 size-full scale-125 object-cover blur-2xl brightness-45"
                  />
                  <Image
                    src={imagen}
                    alt={foto.alt}
                    widths={[320, 640, 960]}
                    sizes="(min-width: 1200px) 290px, (min-width: 768px) 50vw, 100vw"
                    class="relative size-full object-contain"
                  />
                </div>
                <div class="flex flex-1 flex-col gap-1.5 p-5">
                  <h3 class="font-bold">{foto.titulo}</h3>
                  <a
                    href={imagen.src}
                    download={foto.archivo}
                    class="mt-auto pt-2 text-small font-bold text-link hover:underline"
                  >
                    {textos.fotos.descargar}
                    <span class="sr-only">: {foto.titulo}</span> <span aria-hidden="true">↓</span>
                  </a>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </Section>

    <Section tone="dark" aria-labelledby="logos-titulo">
      <div class="flex flex-col gap-7">
        <div class="flex flex-col gap-2.5">
          <Eyebrow>{textos.logos.eyebrow}</Eyebrow>
          <h2 id="logos-titulo" class="text-heading font-bold text-balance">
            {textos.logos.titulo}
          </h2>
          <p class="max-w-[64ch] text-text-secondary-on-dark">{textos.logos.texto}</p>
        </div>
        <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-4">
          {logos.map((logo) => (
            <li class="flex flex-col overflow-hidden rounded-lg border border-hairline">
              <div class:list={['grid h-44 place-items-center p-8', logo.fondo]}>
                <Image src={logo.imagen} alt={logo.alt} class="h-10 w-auto max-w-full" />
              </div>
              <div class="flex flex-wrap items-center justify-between gap-3 bg-surface-raised p-5">
                <span class="text-small font-bold">{logo.etiqueta}</span>
                <span class="flex gap-3">
                  {logo.archivos.map((a) => (
                    <a
                      href={a.href}
                      download={a.archivo}
                      class="text-small font-bold text-link hover:underline"
                    >
                      {a.formato}
                      <span class="sr-only"> · {a.etiqueta}</span> <span aria-hidden="true">↓</span>
                    </a>
                  ))}
                </span>
              </div>
            </li>
          ))}
          <li class="flex flex-col overflow-hidden rounded-lg border border-hairline">
            <div class="grid h-44 grid-cols-2">
              <div class="grid place-items-center bg-white p-6">
                <Image src={iconSvg} alt={monograma!.alt} class="h-14 w-auto" />
              </div>
              <div class="grid place-items-center bg-night p-6">
                <Image src={iconBlancoSvg} alt="" class="h-14 w-auto" />
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3 bg-surface-raised p-5">
              <span class="text-small font-bold">{monograma!.etiqueta}</span>
              <span class="flex flex-wrap gap-3">
                {[
                  ...descargas(iconSvg, iconPng, 'monograma-lr-color', `${monograma!.alt} · color`),
                  ...descargas(
                    iconBlancoSvg,
                    iconBlancoPng,
                    'monograma-lr-blanco',
                    `${monograma!.alt} · blanco`,
                  ),
                ].map((a) => (
                  <a
                    href={a.href}
                    download={a.archivo}
                    class="text-small font-bold text-link hover:underline"
                  >
                    {a.formato}
                    <span class="sr-only"> · {a.etiqueta}</span> <span aria-hidden="true">↓</span>
                  </a>
                ))}
              </span>
            </div>
          </li>
        </ul>
      </div>
    </Section>
  </>
)}

{seccion === 'xprize' && (
  <>
    <Section tone="dark" aria-labelledby="xprize-titulo">
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-start gap-12">
        <div class="flex min-w-0 flex-col gap-4">
          <Eyebrow>{textos.xprize.eyebrow}</Eyebrow>
          <h2 id="xprize-titulo" class="text-heading font-bold text-balance">
            {textos.xprize.titulo}
          </h2>
          <p class="text-text-secondary-on-dark">{textos.xprize.texto}</p>
          <a
            href={textos.xprize.fuente.url}
            target="_blank"
            rel="noopener"
            class="self-start font-bold text-link hover:underline"
          >
            {textos.xprize.fuente.texto} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <dl class="grid rounded-lg border border-hairline bg-surface-raised p-6">
          {textos.xprize.datos.map((dato, i) => (
            <div class:list={['grid gap-1 py-3.5', i > 0 && 'border-t border-hairline']}>
              <dt class="text-[11px] font-bold tracking-[0.12em] text-cyan-300 uppercase">
                {dato.clave}
              </dt>
              <dd class="font-bold">{dato.valor}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Section>

    <Section tone="brand" id="descargar" aria-labelledby="kit-titulo">
      <div class="flex flex-wrap items-center justify-between gap-6">
        <div class="flex max-w-[60ch] flex-col gap-2.5">
          <h2 id="kit-titulo" class="text-heading font-bold text-balance">
            {textos.kit.titulo}
          </h2>
          <p class="text-ink-muted">{textos.kit.texto}</p>
        </div>
        <Button href={kitHref} size="lg" download>
          {textos.kit.boton}
        </Button>
      </div>
    </Section>
  </>
)}
