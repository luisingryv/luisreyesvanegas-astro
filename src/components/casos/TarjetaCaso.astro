---
// Tarjeta de un caso en el índice (Luis, 22 nov 2026): arriba, una caja con el logo del cliente
// centrado sobre el color que mejor lo favorece; abajo, la información. Todas las tarjetas de una
// fila miden lo mismo. Los casos sin página propia se muestran sin enlace. La cifra cuenta al verse.
import { Image } from 'astro:assets';
import type { PublishedLocale } from '../../i18n/config';
import { localizedPath } from '../../i18n/routes';
import type { Caso, PaginaCasos } from '../../lib/content';

interface Props {
  locale: PublishedLocale;
  caso: Caso;
  textos: PaginaCasos;
}

const { locale, caso, textos } = Astro.props;
const Tag = caso.pagina ? 'a' : 'article';
const temas = caso.temas.map((t) => textos.filtros.temas[t]).join(' · ');
const logo = caso.caja?.logo ?? caso.logo;
---

<Tag
  href={caso.pagina ? `${localizedPath(locale, 'casos')}/${caso.id}` : undefined}
  class:list={[
    'tarjeta group flex h-full min-w-0 flex-col overflow-hidden rounded-lg border border-blue-200 bg-surface-raised text-ink',
    caso.pagina && 'enlazada',
  ]}
  data-cifra-protagonista
>
  {logo && (
    <div
      class="caja grid aspect-[16/7] place-items-center border-b border-black/5 px-8"
      style={`background: ${caso.caja?.fondo ?? '#ffffff'}`}
    >
      <Image
        src={logo}
        alt={caso.logoAlt ?? caso.cliente}
        width={176}
        densities={[1, 2]}
        class="logo h-auto max-h-16 w-44 object-contain"
      />
    </div>
  )}
  <div class="flex grow flex-col gap-2.5 p-5.5">
    <div class="flex flex-wrap gap-1.5">
      <span class="rounded-pill bg-primary px-2.25 py-1.25 text-label font-bold text-on-primary uppercase">
        {textos.filtros.tipos[caso.tipo]}
      </span>
      <span class="rounded-pill border border-primary px-2.25 py-1.25 text-label font-bold tracking-normal text-blue-600">
        {temas}
      </span>
    </div>
    {caso.tarjeta.metrica && (
      <p
        class="text-[clamp(28px,2.8vw,36px)] leading-[1.1] font-bold text-link tabular-nums"
        data-metrica
      >
        {caso.tarjeta.metrica}
      </p>
    )}
    <h2 class="text-title-sm leading-[1.3] font-bold">{caso.tarjeta.titulo}</h2>
    <p class="mt-auto pt-1 text-[12px] text-ink-muted">{caso.tarjeta.quien}</p>
    {caso.pagina && (
      <span class="font-bold text-link">
        {textos.verCaso}{' '}
        <span
          aria-hidden="true"
          class="inline-block transition-transform group-hover:translate-x-1"
        >
          →
        </span>
      </span>
    )}
  </div>
</Tag>

<style>
  .tarjeta {
    transition:
      border-color 0.25s ease,
      transform 0.35s var(--ease-brand),
      box-shadow 0.35s var(--ease-brand);
  }
  .logo {
    transition: transform 0.45s var(--ease-brand);
  }
  .enlazada:hover,
  .enlazada:focus-visible {
    border-color: var(--color-primary);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px color-mix(in oklab, var(--color-night) 12%, transparent);
  }
  .enlazada:hover .logo,
  .enlazada:focus-visible .logo {
    transform: scale(1.04);
  }
  @media (prefers-reduced-motion: reduce) {
    .enlazada:hover,
    .enlazada:focus-visible,
    .enlazada:hover .logo,
    .enlazada:focus-visible .logo {
      transform: none;
    }
  }
</style>
