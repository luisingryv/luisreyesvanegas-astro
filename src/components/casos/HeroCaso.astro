---
// Cabecera del caso: volver, tipo y temas, título y resumen. La pieza 11 va debajo, a todo el
// ancho (en el espacio "imagen o diagrama" del prototipo; Luis, 20 nov 2026). Desde el 22 nov
// 2026 lleva el logo del cliente sobre las etiquetas.
import { Image } from 'astro:assets';
import Section from '../brand/Section.astro';
import FlujoCaso from './FlujoCaso.astro';
import type { PublishedLocale } from '../../i18n/config';
import { localizedPath } from '../../i18n/routes';
import type { Caso, PaginaCasos } from '../../lib/content';

interface Props {
  locale: PublishedLocale;
  caso: Caso & { pagina: NonNullable<Caso['pagina']> };
  textos: PaginaCasos;
}

const { locale, caso, textos } = Astro.props;
const temas = caso.temas.map((t) => textos.filtros.temas[t]).join(' · ');
---

<Section tone="light" class="py-[clamp(40px,6vw,88px)]!" aria-labelledby="caso-titulo">
  <div class="flex flex-col gap-10">
    <div class="flex max-w-[72ch] flex-col gap-4.5">
      <a
        href={localizedPath(locale, 'casos')}
        class="self-start text-small font-bold text-link hover:underline"
      >
        <span aria-hidden="true">←</span> {textos.plantilla.volver}
      </a>
      {caso.logo && (
        <Image
          src={caso.logo}
          alt={caso.logoAlt ?? caso.cliente}
          height={56}
          densities={[1, 2]}
          class="h-auto max-h-14 w-auto max-w-56 self-start object-contain"
        />
      )}
      <div class="flex flex-wrap gap-1.5">
        <span class="rounded-pill bg-primary px-2.25 py-1.25 text-label font-bold text-on-primary uppercase">
          {textos.filtros.tipos[caso.tipo]}
        </span>
        <span class="rounded-pill border border-primary px-2.25 py-1.25 text-label font-bold tracking-normal text-blue-600">
          {temas}
        </span>
      </div>
      <h1
        id="caso-titulo"
        class="text-[clamp(34px,4.4vw,56px)] leading-[1.06] font-bold tracking-[-0.02em] text-balance"
      >
        {caso.pagina.titulo}
      </h1>
      <p class="text-[18px] text-ink-muted">{caso.pagina.resumen}</p>
    </div>
    {caso.diagrama && (
      <FlujoCaso locale={locale} diagrama={caso.diagrama} textos={textos.plantilla.diagrama} />
    )}
  </div>
</Section>
