---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { variant = 'primary', class: className, ...rest } = Astro.props;

const variants = {
  primary: 'bg-primary text-on-primary hover:bg-blue-600',
  secondary: 'border-ink text-ink hover:bg-surface-raised',
} as const;
---

<a
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-pill border-2 border-transparent px-6 py-3',
    'text-body leading-none font-bold whitespace-nowrap transition-colors duration-150',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
