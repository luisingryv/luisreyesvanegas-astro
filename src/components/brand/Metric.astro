---
import Flecha from './Flecha.astro';
interface Source {
  text: string;
  href?: string;
}

interface Props {
  value: string;
  label?: string;
  source?: Source;
  size?: 'chip' | 'large';
}

const { value, label, source, size = 'large' } = Astro.props;
---

{size === 'chip' ? (
  <span class="inline-flex items-baseline gap-1.5 self-start rounded-sm bg-accent px-3 py-2 text-caption leading-none font-bold text-night">
    {value}
    {label && <span>{label}</span>}
  </span>
) : (
  <div class="flex flex-col gap-1">
    <p class="text-heading font-bold text-link">{value}</p>
    {label && <p class="text-body text-ink">{label}</p>}
    {source && (
      <p class="text-caption text-ink-muted">
        {source.href ? (
          <a href={source.href} class="underline underline-offset-2 hover:text-ink">
            {source.text}
            <Flecha externa />
          </a>
        ) : (
          source.text
        )}
      </p>
    )}
  </div>
)}
