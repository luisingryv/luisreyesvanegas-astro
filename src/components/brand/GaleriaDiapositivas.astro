---
// Fotos de una galería (decisión del 21 nov 2026). La página propia de cada galería
// (/[lang]/galerias/[id]) las muestra en columna; el visor (GaleriaVisor) descarga esa página
// al abrirse y copia estas fotos a su carrusel. Así el HTML de Sobre mí y Eventos no carga las
// fotos de todas sus galerías (Lighthouse en celular). Las fotos van completas, sin recorte.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  fotos: { foto: ImageMetadata; alt: string; pie?: string }[];
}

const { fotos } = Astro.props;
// Anchos del srcset sin pasarse del original (máximo 1800 px).
const anchos = (ancho: number) => [
  ...[480, 800, 1200].filter((w) => w < ancho),
  Math.min(ancho, 1800),
];
---

<ul class="pista" data-pista>
  {fotos.map((f, i) => (
    <li class="diapositiva" data-foto={i}>
      <figure class="contenido">
        <Image
          src={f.foto}
          alt={f.alt}
          widths={anchos(f.foto.width)}
          sizes="(min-width: 1024px) 80vw, 100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          class="imagen"
        />
        {f.pie && (
          <figcaption class="pie text-small text-text-secondary-on-dark">{f.pie}</figcaption>
        )}
      </figure>
    </li>
  ))}
</ul>

<style>
  /* En la página de la galería: una foto debajo de otra. */
  .pista {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contenido {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    margin: 0;
  }
  .imagen {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 85vh;
    border-radius: 12px;
    background: var(--color-surface-raised);
  }
  .pie {
    max-width: 60ch;
    text-align: center;
  }
</style>
