---
import type { PublishedLocale } from '../../i18n/config';
import { getDictionary } from '../../i18n';
import { localizedPath, seccionDe, type RouteKey } from '../../i18n/routes';

interface Props {
  locale: PublishedLocale;
  current?: RouteKey;
  orientation: 'horizontal' | 'vertical';
}

const { locale, current: ruta, orientation } = Astro.props;
const current = ruta && (seccionDe[ruta] ?? ruta);
const t = getDictionary(locale);

const items = ['consultoria', 'productos', 'casos', 'eventos', 'sobreMi'] as const;
---

<nav aria-label={t.a11y.mainNav}>
  <ul
    class:list={[
      'flex text-small font-bold',
      orientation === 'horizontal' ? 'items-center gap-6' : 'flex-col items-start gap-1',
    ]}
  >
    {items.map((key) => (
      <li>
        <a
          href={localizedPath(locale, key)}
          aria-current={key === current ? 'page' : undefined}
          class:list={[
            'block border-b-2 py-2.5 transition-colors duration-150',
            key === current
              ? 'border-current text-link'
              : 'border-transparent text-ink hover:text-link',
          ]}
        >
          {t.nav[key]}
        </a>
      </li>
    ))}
  </ul>
</nav>
