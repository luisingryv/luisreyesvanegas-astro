---
interface Props {
  tone?: 'raised' | 'surface' | 'brand';
  radius?: 'lg' | 'md';
  as?: 'div' | 'article' | 'li';
  class?: string;
}

const { tone = 'raised', radius = 'lg', as: Tag = 'div', class: className } = Astro.props;

const tones = {
  raised: 'bg-surface-raised',
  surface: 'border border-hairline bg-surface',
  brand: 'bg-surface',
} as const;
---

<Tag
  data-theme={tone === 'brand' ? 'brand' : undefined}
  class:list={[
    'flex min-w-0 flex-col gap-3 p-6',
    radius === 'md' ? 'rounded-md' : 'rounded-lg',
    tones[tone],
    className,
  ]}
>
  <slot />
</Tag>
