---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import MonogramCurves from './MonogramCurves.astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
}

const { image, alt } = Astro.props;
// max-w-120 × max-h-150 (480 × 600) mantiene el 4:5 cuando la columna es más ancha.
const frame = 'mx-auto aspect-4/5 max-h-150 w-full max-w-120 rounded-lg';
---

{image && alt ? (
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 640, 800, 1024].filter((w) => w <= image.width)}
    sizes="(min-width: 1024px) 480px, 100vw"
    loading="eager"
    fetchpriority="high"
    class:list={[frame, 'object-cover object-[center_30%]']}
  />
) : (
  <div
    aria-hidden="true"
    class:list={[frame, 'relative overflow-hidden border border-hairline bg-surface-raised']}
  >
    <MonogramCurves class="absolute -right-1/4 -bottom-1/4 size-[120%] opacity-80" />
  </div>
)}
