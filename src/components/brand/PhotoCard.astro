---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Eyebrow from './Eyebrow.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title?: string;
  titleAs?: 'h3' | 'p';
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const {
  image,
  alt,
  eyebrow,
  title,
  titleAs: Title = 'p',
  sizes = '(min-width: 768px) 50vw, 100vw',
  loading = 'lazy',
} = Astro.props;
---

<figure class="flex flex-col gap-4">
  <div class="relative aspect-4/3 overflow-hidden rounded-lg bg-night">
    <Image
      src={image}
      alt=""
      width={48}
      loading={loading}
      class="absolute inset-0 size-full scale-125 object-cover blur-2xl brightness-50"
    />
    <Image
      src={image}
      alt={alt}
      widths={[400, 800, 1200]}
      sizes={sizes}
      loading={loading}
      class="relative size-full object-contain"
    />
  </div>
  {
    (eyebrow || title) && (
      <figcaption class="flex flex-col gap-1">
        {eyebrow && <Eyebrow as="span">{eyebrow}</Eyebrow>}
        {title && <Title class="text-body font-bold text-ink">{title}</Title>}
      </figcaption>
    )
  }
</figure>
