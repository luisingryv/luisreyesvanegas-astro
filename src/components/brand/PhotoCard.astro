---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  meta?: string;
  /** Pastilla a la derecha de meta (tipo de evento). */
  etiqueta?: string;
  title?: string;
  description?: string;
  titleAs?: 'h3' | 'p';
  variant?: 'plain' | 'card';
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const {
  image,
  alt,
  meta,
  etiqueta,
  title,
  description,
  titleAs: Title = 'p',
  variant = 'plain',
  sizes = '(min-width: 768px) 50vw, 100vw',
  loading = 'lazy',
} = Astro.props;

const isCard = variant === 'card';

// La foto va completa (contain) en un marco 4:3: una foto vertical se ve más angosta que el marco.
// sizes describe el ancho del marco; se escala al ancho real para no bajar píxeles de más.
const proporcion = image.width / image.height / (4 / 3);
const sizesReales =
  proporcion >= 1
    ? sizes
    : sizes
        .split(',')
        .map((parte) => {
          const trozos = parte.trim().split(/\s+/);
          const ancho = trozos.pop()!;
          return [...trozos, `calc(${ancho} * ${proporcion.toFixed(3)})`].join(' ');
        })
        .join(', ');
---

<figure
  class:list={[
    'flex min-w-0 flex-col',
    isCard ? 'overflow-hidden rounded-lg border border-hairline bg-surface-raised' : 'gap-4',
  ]}
>
  <div
    class:list={['relative aspect-4/3 overflow-hidden bg-surface-raised', !isCard && 'rounded-lg']}
  >
    <Image
      src={image}
      alt=""
      width={48}
      loading={loading}
      class="absolute inset-0 size-full scale-125 object-cover blur-2xl brightness-45"
    />
    <Image
      src={image}
      alt={alt}
      widths={[320, 480, 640, 800, 1200]}
      sizes={sizesReales}
      loading={loading}
      quality={isCard ? 70 : undefined}
      class="relative size-full object-contain"
    />
  </div>
  {(meta || title) && (
    <figcaption class:list={['flex flex-col gap-1.5', isCard && 'p-5']}>
      {meta && !etiqueta && <span class="text-caption text-blue-300">{meta}</span>}
      {meta && etiqueta && (
        <span class="flex flex-wrap items-center justify-between gap-2">
          <span class="text-caption text-blue-300">{meta}</span>
          <span class="rounded-pill bg-accent px-2 py-1 text-[11px] leading-none font-bold text-night">
            {etiqueta}
          </span>
        </span>
      )}
      {title && <Title class="text-title-sm font-bold text-ink">{title}</Title>}
      {description && <p class="text-small text-ink-muted">{description}</p>}
    </figcaption>
  )}
</figure>
