---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'>;

const { class: className, ...rest } = Astro.props;
---

<!-- box-content: el margen lateral va por fuera de los 1200 px de contenido, como en el prototipo -->
<div class:list={['mx-auto box-content max-w-(--width-container) px-gutter', className]} {...rest}>
  <slot />
</div>
