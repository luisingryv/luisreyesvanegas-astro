---
// Visor de fotos (decisión del 21 nov 2026): uno por página, lo abren los niveles de "Mi
// historia" en Sobre mí y las tarjetas de Eventos. Cada enlace apunta a la página propia de su
// galería (/[lang]/galerias/[id]); con JavaScript el visor descarga esa página al abrirse (o al
// pasar el cursor por el enlace) y muestra sus fotos en un carrusel con scroll-snap, con
// flechas, teclado y contador. Sin JavaScript el enlace abre la página de la galería.
import type { Dictionary } from '../../i18n/es';

interface Props {
  textos: Dictionary['galeria'];
}

const { textos } = Astro.props;
---

<dialog
  id="visor-galeria"
  class="galeria"
  data-theme="dark"
  aria-labelledby="visor-galeria-titulo"
  data-posicion={textos.posicion}
>
  <div class="marco">
    <header class="cab">
      <div class="min-w-0">
        <p
          id="visor-galeria-titulo"
          class="truncate text-title-sm font-bold text-ink"
          data-titulo
        ></p>
        <p class="truncate text-caption text-blue-300" data-sub></p>
      </div>
      <p class="contador text-caption text-ink-muted" aria-live="polite" data-contador></p>
      <button type="button" class="cerrar" data-cerrar>
        <span class="sr-only">{textos.cerrar}</span>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
        </svg>
      </button>
    </header>

    {/* Enfocable con teclado (región con scroll, WCAG 2.1.1): las flechas también la mueven. */}
    <ul class="pista" data-pista tabindex="0" aria-labelledby="visor-galeria-titulo"></ul>
    <span class="cargando" aria-hidden="true" data-cargando></span>

    <button type="button" class="flecha anterior" data-anterior aria-label={textos.anterior}>
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button type="button" class="flecha siguiente" data-siguiente aria-label={textos.siguiente}>
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</dialog>

<style>
  .galeria {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-night);
    color: var(--color-ink);
    overscroll-behavior: contain;
  }
  .galeria::backdrop {
    background: transparent;
  }
  .galeria[open] {
    opacity: 1;
    transition:
      opacity 0.25s var(--ease-brand),
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }
  @starting-style {
    .galeria[open] {
      opacity: 0;
    }
  }
  :global(html:has(.galeria[open])) {
    overflow: hidden;
  }

  .marco {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100%;
  }
  .cab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid var(--color-hairline);
  }
  .contador {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cerrar,
  .flecha {
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    transition:
      background-color 0.2s,
      color 0.2s,
      opacity 0.2s;
  }
  .cerrar {
    width: 2.75rem;
    height: 2.75rem;
    background: color-mix(in oklab, var(--color-white) 8%, transparent);
  }
  .cerrar:hover {
    background: color-mix(in oklab, var(--color-white) 18%, transparent);
  }
  .cerrar svg,
  .flecha svg {
    width: 1.375rem;
    height: 1.375rem;
  }
  .cerrar:focus-visible,
  .flecha:focus-visible,
  .pista:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .pista:focus-visible {
    outline-offset: -4px;
  }

  /* Carrusel: cada foto ocupa el ancho del visor y encaja al deslizar. */
  .pista {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior: contain;
    scrollbar-width: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pista::-webkit-scrollbar {
    display: none;
  }
  .pista:focus {
    outline: none;
  }
  /* Las fotos llegan de la página de la galería: estilos globales dentro del visor. */
  .pista :global(.diapositiva) {
    flex: 0 0 100%;
    display: grid;
    place-items: center;
    padding: clamp(0.75rem, 2.5vw, 2rem) clamp(0.75rem, 6vw, 5.5rem);
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }
  .pista :global(.contenido) {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
  }
  .pista :global(.imagen) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100dvh - 10.5rem);
    object-fit: contain;
    border-radius: 12px;
    background: var(--color-surface-raised);
  }
  .pista :global(.pie) {
    max-width: 60ch;
    text-align: center;
  }

  .cargando {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.5rem;
    height: 2.5rem;
    margin: -1.25rem 0 0 -1.25rem;
    border: 3px solid color-mix(in oklab, var(--color-white) 18%, transparent);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    animation: girar 0.9s linear infinite;
  }
  .galeria[data-cargando] .cargando {
    opacity: 1;
  }
  @keyframes girar {
    to {
      transform: rotate(1turn);
    }
  }

  .flecha {
    position: absolute;
    top: 50%;
    width: 3rem;
    height: 3rem;
    background: color-mix(in oklab, var(--color-white) 10%, transparent);
    transform: translateY(-50%);
  }
  .flecha:hover:not(:disabled) {
    background: var(--color-accent);
    color: var(--color-night);
  }
  .flecha:disabled {
    opacity: 0.25;
    cursor: default;
  }
  .galeria[data-una] .flecha {
    display: none;
  }
  .anterior {
    left: clamp(0.5rem, 2vw, 1.5rem);
  }
  .siguiente {
    right: clamp(0.5rem, 2vw, 1.5rem);
  }
  @media (max-width: 40rem) {
    .flecha {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
    .pista :global(.imagen) {
      max-height: calc(100dvh - 12rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .galeria[open] {
      transition: none;
    }
    .cargando {
      animation-duration: 2.4s;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../motion/motion';

  const dialogo = document.getElementById('visor-galeria') as HTMLDialogElement | null;

  if (dialogo) {
    const pista = dialogo.querySelector<HTMLElement>('[data-pista]')!;
    const titulo = dialogo.querySelector<HTMLElement>('[data-titulo]')!;
    const sub = dialogo.querySelector<HTMLElement>('[data-sub]')!;
    const contador = dialogo.querySelector<HTMLElement>('[data-contador]')!;
    const anterior = dialogo.querySelector<HTMLButtonElement>('[data-anterior]')!;
    const siguiente = dialogo.querySelector<HTMLButtonElement>('[data-siguiente]')!;
    const plantilla = dialogo.dataset.posicion ?? '{i} / {n}';
    let fotos: HTMLElement[] = [];
    let actual = 0;
    let observador: IntersectionObserver | undefined;
    let apertura = 0;

    // Fotos de cada galería, descargadas una sola vez (al abrir o al pasar el cursor).
    const descargas = new Map<string, Promise<Element[]>>();
    const descargar = (url: string) => {
      if (!descargas.has(url)) {
        const promesa = fetch(url)
          .then((r) => (r.ok ? r.text() : Promise.reject(new Error(String(r.status)))))
          .then((html) => {
            const doc = new DOMParser().parseFromString(html, 'text/html');
            return [...doc.querySelectorAll('[data-galeria-fuente] [data-pista] > li')];
          });
        promesa.catch(() => descargas.delete(url));
        descargas.set(url, promesa);
      }
      return descargas.get(url)!;
    };

    const pintar = () => {
      contador.textContent = fotos.length
        ? plantilla.replace('{i}', String(actual + 1)).replace('{n}', String(fotos.length))
        : '';
      anterior.disabled = actual === 0;
      siguiente.disabled = actual >= fotos.length - 1;
      // Precarga la foto siguiente y la anterior para que el cambio no muestre un vacío.
      [actual - 1, actual + 1].forEach((i) => {
        const img = fotos[i]?.querySelector('img');
        if (img) img.loading = 'eager';
      });
    };

    const ir = (i: number, suave = true) => {
      if (!fotos.length) return;
      const destino = Math.min(Math.max(i, 0), fotos.length - 1);
      pista.scrollTo({
        left: fotos[destino]!.offsetLeft,
        behavior: suave && !prefersReducedMotion() ? 'smooth' : 'instant',
      });
      actual = destino;
      pintar();
    };

    /** inicio: la foto con la que abre (las fotos al lado de la línea de tiempo, 27 nov 2026). */
    const montar = (nodos: Element[], inicio = 0) => {
      observador?.disconnect();
      pista.replaceChildren(...nodos.map((n) => document.importNode(n, true)));
      fotos = [...pista.querySelectorAll<HTMLElement>('[data-foto]')];
      dialogo.toggleAttribute('data-una', fotos.length < 2);
      // La foto visible manda (también al deslizar con el dedo o el trackpad).
      observador = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (e.isIntersecting) {
              actual = Number((e.target as HTMLElement).dataset.foto);
              pintar();
            }
          }
        },
        { root: pista, threshold: 0.6 },
      );
      fotos.forEach((f) => observador!.observe(f));
      const primera = fotos[Math.min(inicio, fotos.length - 1)]?.querySelector('img');
      if (primera) primera.loading = 'eager';
      ir(inicio, false);
    };

    const abrir = async (enlace: HTMLAnchorElement) => {
      const esta = ++apertura;
      titulo.textContent = enlace.dataset.titulo ?? '';
      sub.textContent = enlace.dataset.sub ?? '';
      observador?.disconnect();
      fotos = [];
      pista.replaceChildren();
      pintar();
      dialogo.setAttribute('data-cargando', '');
      if (!dialogo.open) dialogo.showModal();
      try {
        const nodos = await descargar(enlace.href);
        if (esta !== apertura || !dialogo.open) return;
        if (!nodos.length) throw new Error('sin fotos');
        montar(nodos, Number(enlace.dataset.indice ?? 0) || 0);
        pista.focus({ preventScroll: true });
      } catch {
        // Si no se pudo descargar, se abre la página de la galería.
        window.location.assign(enlace.href);
      } finally {
        if (esta === apertura) dialogo.removeAttribute('data-cargando');
      }
    };

    anterior.addEventListener('click', () => ir(actual - 1));
    siguiente.addEventListener('click', () => ir(actual + 1));
    dialogo.querySelector('[data-cerrar]')!.addEventListener('click', () => dialogo.close());
    dialogo.addEventListener('keydown', (e) => {
      const teclas: Record<string, () => void> = {
        ArrowRight: () => ir(actual + 1),
        ArrowLeft: () => ir(actual - 1),
        Home: () => ir(0),
        End: () => ir(fotos.length - 1),
      };
      const accion = teclas[e.key];
      if (accion) {
        e.preventDefault();
        accion();
      }
    });
    dialogo.addEventListener('close', () => {
      apertura++;
      observador?.disconnect();
    });

    const enlaceDe = (e: Event) =>
      (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[data-abrir-galeria]') ?? null;
    document.addEventListener('click', (e) => {
      const enlace = enlaceDe(e);
      if (!enlace) return;
      e.preventDefault();
      void abrir(enlace);
    });
    // Intención de abrir: descarga anticipada para que el visor abra con las fotos listas.
    const anticipar = (e: Event) => {
      const enlace = enlaceDe(e);
      if (enlace) descargar(enlace.href).catch(() => {});
    };
    document.addEventListener('pointerover', anticipar, { passive: true });
    document.addEventListener('focusin', anticipar);
  }
</script>
