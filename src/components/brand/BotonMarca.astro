---
// Botón con el color de una marca aliada (EvolutecC, Nexa Connect). Luis, 22 nov 2026: letra
// blanca y la flecha solo al pasar el cursor o al enfocar, como en las tarjetas del Home. El
// texto va grande (19 px en negrita) para que el blanco sobre naranja cumpla el contraste AA.
interface Props {
  href: string;
  /** Color de fondo y de fondo al pasar el cursor (variables CSS de la marca). */
  fondo: string;
  fondoHover: string;
  /** Abre otro sitio: flecha ↗ y pestaña nueva. */
  externo?: boolean;
  class?: string;
}

const { href, fondo, fondoHover, externo = true, class: clase } = Astro.props;
---

<a
  href={href}
  target={externo ? '_blank' : undefined}
  rel={externo ? 'noopener' : undefined}
  class:list={['boton-marca inline-flex items-center rounded-pill font-bold', clase]}
  style={`--fondo: ${fondo}; --fondo-hover: ${fondoHover};`}
>
  <slot />
  <span aria-hidden="true" class="flecha">
    {externo ? '↗' : '→'}
  </span>
</a>

<style>
  .boton-marca {
    gap: 0;
    padding: 0.85rem 1.6rem;
    font-size: 19px;
    line-height: 1.2;
    color: var(--color-white);
    background: var(--fondo);
    transition:
      background-color 0.2s ease,
      transform 0.3s var(--ease-brand),
      box-shadow 0.3s var(--ease-brand),
      gap 0.3s var(--ease-brand);
  }
  .flecha {
    display: inline-block;
    width: 0;
    overflow: hidden;
    opacity: 0;
    transform: translate(-6px, 6px);
    transition:
      opacity 0.25s ease,
      transform 0.35s var(--ease-brand),
      width 0.3s var(--ease-brand);
  }
  .boton-marca:hover,
  .boton-marca:focus-visible {
    gap: 0.5rem;
    background: var(--fondo-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px color-mix(in oklab, var(--fondo) 40%, transparent);
  }
  .boton-marca:hover .flecha,
  .boton-marca:focus-visible .flecha {
    width: 1em;
    opacity: 1;
    transform: none;
  }
  .boton-marca:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .boton-marca,
    .boton-marca:hover,
    .boton-marca:focus-visible {
      transform: none;
      transition: none;
    }
    .flecha {
      transition: none;
    }
  }
</style>
