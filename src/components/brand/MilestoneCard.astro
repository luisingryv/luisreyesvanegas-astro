---
import Metric from './Metric.astro';

interface Props {
  year: number;
  age: string;
  title: string;
  text: string;
  stat: string;
  impactLabel: string;
  impact: string;
  link?: { texto: string; url: string };
}

const { year, age, title, text, stat, impactLabel, impact, link } = Astro.props;
---

<article
  class="flex min-w-0 flex-col gap-2.5 rounded-md border border-hairline bg-surface-raised p-5"
>
  <p class="flex flex-wrap items-baseline gap-2.5">
    <span class="text-title-md font-bold">{year}</span>
    <span
      class="rounded-pill border border-gray-700 px-2.5 py-1 text-label font-bold tracking-normal text-text-tertiary-on-dark"
    >
      {age}
    </span>
  </p>
  <h4 class="text-title-sm font-bold">{title}</h4>
  <p class="text-small text-text-secondary-on-dark">{text}</p>
  <div class="flex" data-stat>
    <Metric size="chip" value={stat} />
  </div>
  <p class="border-t border-hairline pt-2.5 text-caption text-text-secondary-on-dark">
    <span class="mr-2 text-label font-bold text-link uppercase">{impactLabel}</span>
    {impact}
  </p>
  {
    link && (
      <a href={link.url} class="text-caption font-bold text-link hover:underline">
        {link.texto}
        <span aria-hidden="true"> ↗</span>
      </a>
    )
  }
</article>
