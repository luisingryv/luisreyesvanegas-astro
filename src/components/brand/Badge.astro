---
interface Props {
  tone?: 'solid' | 'soft' | 'dashed';
  class?: string;
}

const { tone = 'solid', class: className } = Astro.props;

const tones = {
  solid: 'border-transparent bg-primary text-on-primary',
  soft: 'border-transparent bg-white text-blue-600',
  dashed: 'border-dashed border-primary text-link',
} as const;
---

<span
  class:list={[
    'inline-flex items-center self-start rounded-pill border px-2.5 py-1.5 text-label font-bold tracking-normal',
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
