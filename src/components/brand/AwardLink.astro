---
// Enlace con forma de insignia a un premio con su fuente (p. ej. XPRIZE en el hero).
import CheckMark from './CheckMark.astro';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2.5 self-start rounded-pill border border-accent py-2 pr-4 pl-2 text-small font-bold text-ink transition-colors hover:bg-surface-raised',
    className,
  ]}
>
  <CheckMark shape="circle" />
  <slot />
</a>
