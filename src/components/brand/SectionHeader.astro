---
import Eyebrow from './Eyebrow.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  level?: 1 | 2 | 3;
  id?: string;
}

const { title, eyebrow, lead, level = 2, id } = Astro.props;
const Heading = `h${level}` as const;
---

<div class="mb-10 flex flex-col gap-6 md:mb-12 md:flex-row md:items-end md:justify-between">
  <div class="flex max-w-3xl flex-col gap-3">
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <Heading id={id} class="text-heading font-bold text-balance text-ink">{title}</Heading>
    {lead && <p class="text-lead text-ink-muted">{lead}</p>}
  </div>
  {
    Astro.slots.has('action') && (
      <div class="shrink-0">
        <slot name="action" />
      </div>
    )
  }
</div>
