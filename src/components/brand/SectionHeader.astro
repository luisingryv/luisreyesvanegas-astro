---
import Eyebrow from './Eyebrow.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  level?: 1 | 2 | 3;
  id?: string;
  flush?: boolean;
}

const { title, eyebrow, lead, level = 2, id, flush = false } = Astro.props;
const Heading = `h${level}` as const;
---

<div class:list={['flex flex-wrap items-end justify-between gap-4', !flush && 'mb-8']}>
  <div class="flex max-w-3xl flex-col gap-2.5">
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <Heading id={id} class="text-heading font-bold text-balance text-ink">{title}</Heading>
    {lead && <p class="text-lead text-ink-muted">{lead}</p>}
  </div>
  <slot name="action" />
</div>
