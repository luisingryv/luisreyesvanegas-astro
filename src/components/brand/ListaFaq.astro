---
// Preguntas frecuentes en dos columnas: la pregunta y su respuesta siempre visibles.
interface Props {
  items: { pregunta: string; respuesta: string }[];
}

const { items } = Astro.props;
---

<dl class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] gap-x-10 gap-y-2">
  {items.map((item) => (
    <div class="flex flex-col gap-1.5 border-b border-blue-200 py-4">
      <dt class="text-[17px] font-bold">{item.pregunta}</dt>
      <dd class="text-[15px] text-ink-muted">{item.respuesta}</dd>
    </div>
  ))}
</dl>
