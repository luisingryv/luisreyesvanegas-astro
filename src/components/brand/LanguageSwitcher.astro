---
// Selector de idioma (22 nov 2026): un botón con el idioma actual que abre la lista de idiomas,
// cada uno escrito en su propia lengua. Lleva a la misma página en el otro idioma, o a su inicio
// si la página no existe en ese idioma (por ejemplo, una noticia escrita solo en español).
// En el menú del celular los idiomas van a la vista, sin desplegable.
import {
  localeLabels,
  localeNames,
  publishedLocales,
  type PublishedLocale,
} from '../../i18n/config';
import { getDictionary } from '../../i18n';
import { localizedPath, type RouteKey } from '../../i18n/routes';

interface Props {
  locale: PublishedLocale;
  route?: RouteKey;
  /** Enlace de cada idioma a esta misma página (lo calcula Base). */
  alternos?: Partial<Record<PublishedLocale, string>>;
  /** menu: botón que abre la lista (header). lista: los idiomas a la vista (menú del celular). */
  variante?: 'menu' | 'lista';
}

const { locale, route = 'home', alternos = {}, variante = 'menu' } = Astro.props;
const t = getDictionary(locale);
const enlace = (code: PublishedLocale) => alternos[code] ?? localizedPath(code, route);
---

{variante === 'lista' ? (
  <nav aria-label={t.a11y.languageNav}>
    <ul class="flex flex-wrap gap-2">
      {publishedLocales.map((code) => (
        <li>
          <a
            href={enlace(code)}
            hreflang={code}
            lang={code}
            aria-current={code === locale ? 'true' : undefined}
            class:list={[
              'inline-flex rounded-pill border px-4 py-2 text-small font-bold transition-colors duration-150',
              code === locale
                ? 'border-accent text-ink'
                : 'border-hairline text-ink-muted hover:border-ink-muted hover:text-ink',
            ]}
          >
            {localeNames[code]}
          </a>
        </li>
      ))}
    </ul>
  </nav>
) : (
  <details class="selector-idioma group relative" data-selector-idioma>
    <summary class="flex cursor-pointer list-none items-center gap-2 rounded-pill border border-gray-700 px-3.5 py-2.5 text-small leading-none font-bold transition-colors duration-150 hover:border-ink-muted [&::-webkit-details-marker]:hidden">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-4.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" />
      </svg>
      <span aria-hidden="true">{localeLabels[locale]}</span>
      <span class="sr-only">
        {t.a11y.cambiarIdioma}: <span lang={locale}>{localeNames[locale]}</span>
      </span>
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-3.5 transition-transform duration-200 group-open:rotate-180"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </summary>
    <nav
      aria-label={t.a11y.languageNav}
      class="absolute top-full right-0 z-50 mt-2 min-w-52 rounded-lg border border-hairline bg-surface-raised p-1.5 shadow-lg"
    >
      <ul class="flex flex-col">
        {publishedLocales.map((code) => (
          <li>
            <a
              href={enlace(code)}
              hreflang={code}
              lang={code}
              aria-current={code === locale ? 'true' : undefined}
              class:list={[
                'flex items-center justify-between gap-6 rounded-md px-3 py-2.5 text-small transition-colors duration-150 hover:bg-surface',
                code === locale ? 'font-bold text-ink' : 'text-ink-muted hover:text-ink',
              ]}
            >
              <span>{localeNames[code]}</span>
              {code === locale ? (
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  class="size-4 text-accent"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m5 12.5 4.5 4.5L19 7.5" />
                </svg>
              ) : (
                <span aria-hidden="true" class="text-caption">
                  {localeLabels[code]}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

<script>
  // Cierra el selector al hacer clic fuera de él o con Escape.
  const abiertos = () =>
    document.querySelectorAll<HTMLDetailsElement>('details[data-selector-idioma][open]');
  document.addEventListener('click', (evento) => {
    for (const selector of abiertos()) {
      if (!selector.contains(evento.target as Node)) selector.open = false;
    }
  });
  document.addEventListener('keydown', (evento) => {
    if (evento.key !== 'Escape') return;
    for (const selector of abiertos()) {
      selector.open = false;
      selector.querySelector('summary')?.focus();
    }
  });
</script>
