---
// Marca de "logro desbloqueado": check night sobre cyan. Decorativa.
interface Props {
  shape?: 'circle' | 'square';
  class?: string;
}

const { shape = 'square', class: className } = Astro.props;
---

<span
  aria-hidden="true"
  class:list={[
    'grid shrink-0 place-items-center bg-accent text-night',
    shape === 'circle' ? 'size-7 rounded-full' : 'size-6.5 rounded-[8px]',
    className,
  ]}
>
  <svg viewBox="0 0 16 16" class="size-3.5" fill="none">
    <path
      d="M3 8.5l3 3 7-7"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
</span>
