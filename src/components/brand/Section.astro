---
import type { HTMLAttributes } from 'astro/types';
import Container from './Container.astro';

interface Props extends HTMLAttributes<'section'> {
  tone?: 'dark' | 'dark-raised' | 'light' | 'light-raised' | 'brand';
  spacing?: 'section' | 'hero';
  separator?: boolean;
  /** Aparición suave al entrar en pantalla (no en el hero ni en secciones con pieza propia). */
  reveal?: boolean;
}

const {
  tone = 'light',
  spacing = 'section',
  separator = false,
  reveal = false,
  class: className,
  ...rest
} = Astro.props;

const tones = {
  dark: { theme: 'dark', bg: 'bg-surface' },
  'dark-raised': { theme: 'dark', bg: 'bg-surface-raised' },
  light: { theme: undefined, bg: 'bg-surface' },
  'light-raised': { theme: undefined, bg: 'bg-surface-raised' },
  brand: { theme: 'brand', bg: 'bg-surface' },
} as const;
---

<section
  data-theme={tones[tone].theme}
  class:list={[
    tones[tone].bg,
    spacing === 'hero' ? 'py-hero-y' : 'py-section-y',
    separator && 'border-t border-hairline',
    className,
  ]}
  {...rest}
>
  <Container data-reveal={reveal ? '' : undefined}>
    <slot />
  </Container>
</section>
