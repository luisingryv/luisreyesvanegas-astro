---
import Flecha from './Flecha.astro';
import Container from './Container.astro';
import Logo from './Logo.astro';
import { evoluteccUrl, site } from '../../config/site';
import type { PublishedLocale } from '../../i18n/config';
import { getDictionary } from '../../i18n';
import { localizedPath } from '../../i18n/routes';

interface Props {
  locale: PublishedLocale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const links = [
  { label: t.footer.linkedin, href: site.linkedin, external: true },
  { label: t.footer.charlas, href: localizedPath(locale, 'speaker'), external: false },
  { label: t.footer.prensa, href: localizedPath(locale, 'prensa'), external: false },
  { label: t.footer.contacto, href: localizedPath(locale, 'contacto'), external: false },
  { label: t.footer.evolutecc, href: evoluteccUrl('footer'), external: true },
  { label: t.footer.legal, href: localizedPath(locale, 'privacidad'), external: false },
];
---

<footer data-theme="dark" class="border-t border-hairline bg-surface text-ink">
  <Container class="flex flex-wrap items-center justify-between gap-5 py-10">
    <a href={localizedPath(locale, 'home')} class="shrink-0">
      <Logo alt={t.meta.siteName} size="sm" />
    </a>
    <nav aria-label={t.a11y.footerNav}>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-small">
        {links.map((link) => (
          <li>
            <a href={link.href} class="text-link underline-offset-2 hover:underline">
              {link.label}
              {link.external && <Flecha externa />}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="text-caption text-ink-muted">{t.footer.copyright}</p>
  </Container>
</footer>
