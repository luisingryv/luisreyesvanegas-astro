---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/marca-h-color-blanco.svg';

interface Props {
  alt: string;
  size?: 'md' | 'sm';
}

const { alt, size = 'md' } = Astro.props;
---

<Image
  src={logo}
  alt={alt}
  loading="eager"
  class:list={['block w-auto', size === 'md' ? 'h-8.5' : 'h-7']}
/>
