---
import Button from './Button.astro';
import Container from './Container.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import NavLinks from './NavLinks.astro';
import { bookingUrl } from '../../config/site';
import type { PublishedLocale } from '../../i18n/config';
import { getDictionary } from '../../i18n';
import { localizedPath, type RouteKey } from '../../i18n/routes';

interface Props {
  locale: PublishedLocale;
  route?: RouteKey;
  /** Ancla propia para "Agendar sesión" (el Home usa '#agenda'). */
  agendaLocal?: string;
  /** Header mínimo de landing: solo logo, idiomas y este botón (Adopción de IA, CV). */
  minimo?: { texto: string; href: string };
  /** Botón de la derecha propio de la página (Eventos y Charlas, Prensa, Programas AWS). */
  cta?: { texto: string; href: string };
  /** Fondo night con logo blanco, o blanco con logo azul en páginas claras. */
  tema?: 'dark' | 'light';
  /** Enlace de cada idioma a esta misma página (lo calcula Base). */
  alternos?: Partial<Record<PublishedLocale, string>>;
}

const { locale, route, agendaLocal, tema = 'dark', minimo, cta, alternos } = Astro.props;
const claro = tema === 'light';
const t = getDictionary(locale);
const ctaHref = minimo?.href ?? cta?.href ?? bookingUrl(locale, agendaLocal);
const ctaTexto = minimo?.texto ?? cta?.texto ?? t.header.cta;
---

<header
  data-theme={claro ? undefined : 'dark'}
  class:list={[
    'relative border-b bg-surface text-ink',
    claro ? 'border-blue-200' : 'border-hairline',
  ]}
>
  <Container class="flex items-center justify-between gap-6 py-4">
    <a href={localizedPath(locale, 'home')} class="shrink-0">
      <Logo alt={t.meta.siteName} version={claro ? 'color' : 'blanco'} />
    </a>

    {minimo ? (
      <div class="flex items-center gap-4">
        <LanguageSwitcher locale={locale} route={route} alternos={alternos} />
        <Button href={ctaHref} size="sm">
          {ctaTexto}
        </Button>
      </div>
    ) : (
      <>
        <div class="hidden xl:block">
          <NavLinks locale={locale} current={route} orientation="horizontal" />
        </div>

        <div class="hidden items-center gap-4 xl:flex">
          <LanguageSwitcher locale={locale} route={route} alternos={alternos} />
          <Button href={ctaHref} size="sm">
            {ctaTexto}
          </Button>
        </div>

        <details class="xl:hidden">
          <summary class="cursor-pointer list-none rounded-pill border border-gray-700 px-4.5 py-3 text-small leading-none font-bold [&::-webkit-details-marker]:hidden">
            {t.a11y.menu}
          </summary>
          <div
            class:list={[
              'absolute inset-x-0 top-full z-40 border-b bg-surface',
              claro ? 'border-blue-200' : 'border-hairline',
            ]}
          >
            <Container class="flex flex-col gap-6 py-6">
              <NavLinks locale={locale} current={route} orientation="vertical" />
              <LanguageSwitcher
                locale={locale}
                route={route}
                alternos={alternos}
                variante="lista"
              />
              <Button href={ctaHref} size="sm" class="self-start">
                {ctaTexto}
              </Button>
            </Container>
          </div>
        </details>
      </>
    )}
  </Container>
</header>
