---
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';
import CasosHome from '../../components/sections/CasosHome.astro';
import CharlasRecientes from '../../components/sections/CharlasRecientes.astro';
import EvoluteccFranja from '../../components/sections/EvoluteccFranja.astro';
import HeroHome from '../../components/sections/HeroHome.astro';
import LogrosHome from '../../components/sections/LogrosHome.astro';
import RouterHome from '../../components/sections/RouterHome.astro';
import SeccionFormulario from '../../components/sections/SeccionFormulario.astro';
import TrayectoriaHome from '../../components/sections/TrayectoriaHome.astro';
import XprizeHome from '../../components/sections/XprizeHome.astro';
import Base from '../../layouts/Base.astro';
import { publishedLocales } from '../../i18n/config';
import { getDictionary } from '../../i18n';
import {
  getCharlasRecientes,
  getFormularioGeneral,
  getLogrosHome,
  getPaginaHome,
  getTrayectoriaHome,
} from '../../lib/content';

export const prerender = true;

export const getStaticPaths = (() =>
  publishedLocales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as InferGetStaticParamsType<typeof getStaticPaths>;
const t = getDictionary(lang);

const [pagina, logros, hitos, charlas, formulario] = await Promise.all([
  getPaginaHome(lang),
  getLogrosHome(lang),
  getTrayectoriaHome(lang),
  getCharlasRecientes(lang),
  getFormularioGeneral(lang),
]);
---

<Base
  locale={lang}
  title={t.pages.home.title}
  description={pagina.hero.bajada}
  route="home"
  agendaLocal="#agenda"
>
  <HeroHome locale={lang} content={pagina.hero} />
  <RouterHome locale={lang} content={pagina.router} />
  <LogrosHome locale={lang} content={pagina.logros} logros={logros} />
  <XprizeHome locale={lang} content={pagina.xprize} />
  <TrayectoriaHome locale={lang} content={pagina.trayectoria} hitos={hitos} />
  <CharlasRecientes locale={lang} content={pagina.charlas} charlas={charlas} />
  <CasosHome locale={lang} content={pagina.casos} />
  <EvoluteccFranja content={pagina.evolutecc} campaign="home" />
  <SeccionFormulario
    locale={lang}
    id="agenda"
    ruta="home"
    eyebrow={pagina.contacto.eyebrow}
    titulo={pagina.contacto.titulo}
    texto={pagina.contacto.texto}
    tema={pagina.contacto.tema}
    temas={pagina.contacto.temas}
    comunes={formulario}
  />
</Base>
