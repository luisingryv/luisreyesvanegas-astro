---
// Una noticia (21 nov 2026): la lectura de Luis, con la fuente citada y enlazada, y un enlace a
// la página del sitio relacionada. Los borradores solo existen en desarrollo, sin indexar.
import Flecha from '../../../components/brand/Flecha.astro';
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';
import { getCollection, render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Container from '../../../components/brand/Container.astro';
import Eyebrow from '../../../components/brand/Eyebrow.astro';
import { publishedLocales } from '../../../i18n/config';
import { getDictionary } from '../../../i18n';
import { localizedPath } from '../../../i18n/routes';
import Base from '../../../layouts/Base.astro';
import { getNoticias } from '../../../lib/content';
import { blogPostingSchema, serializeJsonLd } from '../../../lib/structured-data';

export const prerender = true;

export const getStaticPaths = (async () => {
  const entradas = await getCollection(
    'noticias',
    (n) => n.data.estado === 'publicada' || import.meta.env.DEV,
  );
  return publishedLocales.flatMap((lang) =>
    entradas.filter((n) => n.data.idioma === lang).map((n) => ({ params: { lang, slug: n.id } })),
  );
}) satisfies GetStaticPaths;

const { lang, slug } = Astro.params as InferGetStaticParamsType<typeof getStaticPaths>;
const t = getDictionary(lang);
const entrada = (await getCollection('noticias', (n) => n.id === slug))[0]!;
const noticia = (await getNoticias(lang)).find((n) => n.id === slug)!;
const { Content } = await render(entrada);
const ruta = `noticias/${slug}`;
const url = new URL(`/${lang}/${ruta}`, Astro.site).toString();
const imagenOg =
  noticia.imagen &&
  (await getImage({ src: noticia.imagen, width: 1200, height: 630, fit: 'cover', format: 'jpg' }));
---

<Base
  locale={lang}
  title={noticia.titulo}
  description={noticia.resumen}
  route="noticias"
  ruta={ruta}
  idiomas={[entrada.data.idioma]}
  type="article"
  image={noticia.imagen}
  imageAlt={noticia.imagenAlt}
  noindex={noticia.borrador}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      blogPostingSchema(
        url,
        noticia,
        noticia.fuente.url,
        lang,
        imagenOg ? new URL(imagenOg.src, Astro.site).toString() : undefined,
      ),
    )}
  />
  <meta slot="head" property="article:published_time" content={noticia.fecha.toISOString()} />
  <article data-theme="dark" class="bg-surface py-[clamp(48px,6vw,88px)]">
    <Container class="flex max-w-[72ch] flex-col gap-6">
      <a
        href={localizedPath(lang, 'noticias')}
        class="self-start font-bold text-link hover:underline"
      >
        <span aria-hidden="true">←</span>
        {t.noticias.volver}
      </a>
      <header class="flex flex-col gap-3">
        <Eyebrow>
          {t.noticias.eyebrow}
          {noticia.borrador && ` · ${t.noticias.borrador}`}
        </Eyebrow>
        <h1 class="text-heading-lg font-bold text-balance">{noticia.titulo}</h1>
        <p class="text-[clamp(17px,1.6vw,19px)] text-text-secondary-on-dark">{noticia.resumen}</p>
        <p class="text-caption text-blue-300">
          <time datetime={noticia.fecha.toISOString().slice(0, 10)}>{noticia.cuando}</time>
          {' · '}
          {t.noticias.fuente}: {noticia.fuente.nombre}
        </p>
      </header>
      {noticia.imagen && noticia.imagenAlt && (
        <figure class="flex flex-col gap-2">
          <Image
            src={noticia.imagen}
            alt={noticia.imagenAlt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 72ch, 100vw"
            loading="eager"
            class="aspect-video w-full rounded-lg object-cover"
          />
          {noticia.imagenCredito && (
            <figcaption class="text-caption text-text-secondary-on-dark">
              {t.noticias.imagen}:{' '}
              {noticia.imagenCreditoUrl ? (
                <a href={noticia.imagenCreditoUrl} rel="noopener" class="underline">
                  {noticia.imagenCredito}
                </a>
              ) : (
                noticia.imagenCredito
              )}
            </figcaption>
          )}
        </figure>
      )}
      <div class="cuerpo flex flex-col gap-4 text-[17px] leading-relaxed text-ink">
        <Content />
      </div>
      <a
        href={noticia.fuente.url}
        rel="noopener"
        class="fuente flex items-center justify-between gap-4 rounded-md border border-hairline bg-surface-raised px-5 py-4 font-bold text-link"
      >
        {t.noticias.leerFuente(noticia.fuente.nombre)}
        <Flecha externa />
      </a>
      {noticia.relacionada && (
        <p class="text-text-secondary-on-dark">
          {t.noticias.relacionada}:{' '}
          <a
            href={localizedPath(lang, noticia.relacionada)}
            class="font-bold text-link hover:underline"
          >
            {t.noticias.paginas[noticia.relacionada]}
          </a>
        </p>
      )}
    </Container>
  </article>
</Base>

<style>
  .cuerpo :global(h2) {
    margin-top: 0.75rem;
    font-size: var(--text-title-md);
    font-weight: 700;
    line-height: 1.2;
  }
  .cuerpo :global(ul),
  .cuerpo :global(ol) {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
  }
  .cuerpo :global(ul) {
    list-style: disc;
  }
  .cuerpo :global(ol) {
    list-style: decimal;
  }
  .cuerpo :global(a) {
    color: var(--color-link);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cuerpo :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-text-secondary-on-dark);
  }
  .fuente {
    transition: border-color 0.2s ease;
  }
  .fuente:hover {
    border-color: var(--color-accent);
  }
</style>
