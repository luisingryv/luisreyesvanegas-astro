---
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';
import Eyebrow from '../../../components/brand/Eyebrow.astro';
import Section from '../../../components/brand/Section.astro';
import ListaCasos from '../../../components/casos/ListaCasos.astro';
import BandaMarca from '../../../components/consultoria/BandaMarca.astro';
import { bookingUrl } from '../../../config/site';
import { publishedLocales } from '../../../i18n/config';
import { getDictionary } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import { getCasos, getPaginaCasos } from '../../../lib/content';

export const prerender = true;

export const getStaticPaths = (() =>
  publishedLocales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const { lang } = Astro.params as InferGetStaticParamsType<typeof getStaticPaths>;
const t = getDictionary(lang);
const [textos, casos] = await Promise.all([getPaginaCasos(lang), getCasos(lang)]);
---

<Base
  locale={lang}
  title={t.pages.casos.title}
  description={textos.hero.texto}
  route="casos"
  tema="light"
>
  <Section
    tone="light"
    spacing="hero"
    class="pb-[clamp(32px,4vw,48px)]!"
    aria-labelledby="casos-titulo"
  >
    <div class="flex flex-col gap-4.5">
      <Eyebrow>{textos.hero.eyebrow}</Eyebrow>
      <h1 id="casos-titulo" class="text-display font-bold">
        {textos.hero.titulo}
      </h1>
      <p class="max-w-[62ch] text-lead text-ink-muted">{textos.hero.texto}</p>
    </div>
  </Section>
  <ListaCasos locale={lang} casos={casos} textos={textos} />
  <BandaMarca
    id="cierre"
    tono="dark"
    titulo={textos.cierre.titulo}
    botones={[{ texto: textos.cierre.boton, href: bookingUrl(lang) }]}
  />
</Base>
