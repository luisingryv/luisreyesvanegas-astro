---
// Página de una galería de fotos (21 nov 2026): todas las fotos de un nivel de "Mi historia" o
// de un evento, una debajo de otra. El visor de Sobre mí y Eventos descarga esta página para
// mostrar las fotos; sin JavaScript, el enlace trae aquí. No se indexa.
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';
import { getCollection } from 'astro:content';
import Container from '../../../components/brand/Container.astro';
import Eyebrow from '../../../components/brand/Eyebrow.astro';
import GaleriaDiapositivas from '../../../components/brand/GaleriaDiapositivas.astro';
import { publishedLocales } from '../../../i18n/config';
import { getDictionary } from '../../../i18n';
import { localizedPath } from '../../../i18n/routes';
import Base from '../../../layouts/Base.astro';
import { getEventos, getGalerias, getHistoria } from '../../../lib/content';

export const prerender = true;

export const getStaticPaths = (async () => {
  const galerias = await getCollection('galerias');
  return publishedLocales.flatMap((lang) => galerias.map(({ id }) => ({ params: { lang, id } })));
}) satisfies GetStaticPaths;

const { lang, id } = Astro.params as InferGetStaticParamsType<typeof getStaticPaths>;
const t = getDictionary(lang);
const [galerias, historia, eventos] = await Promise.all([
  getGalerias(lang),
  getHistoria(lang),
  getEventos(lang),
]);

let titulo = '';
let sub = '';
let volver = { texto: '', href: '' };
let fotos = galerias.charlas[id.replace(/^evento-/, '')] ?? [];
if (id.startsWith('nivel-')) {
  const nivel = historia.niveles.find((n) => `nivel-${n.id}` === id)!;
  titulo = `${t.historia.nivel(nivel.nivel)} · ${nivel.nombre}`;
  sub = nivel.periodo;
  fotos = galerias.capitulos[nivel.id] ?? [];
  volver = { texto: t.nav.sobreMi, href: localizedPath(lang, 'sobreMi') };
} else {
  const evento = eventos.find((e) => `evento-${e.id}` === id)!;
  titulo = evento.evento;
  sub = evento.cuando;
  volver = { texto: t.nav.eventos, href: localizedPath(lang, 'eventos') };
}
---

<Base locale={lang} title={titulo} description={sub} noindex>
  <section data-theme="dark" class="bg-surface py-[clamp(40px,5vw,72px)]">
    <Container class="flex flex-col gap-8">
      <header class="flex flex-col gap-3">
        <a href={volver.href} class="self-start font-bold text-link hover:underline">
          <span aria-hidden="true">←</span>
          {volver.texto}
        </a>
        <Eyebrow>{t.galeria.ver(fotos.length)}</Eyebrow>
        <h1 class="text-heading-lg font-bold text-balance">{titulo}</h1>
        <p class="text-caption text-blue-300">{sub}</p>
      </header>
      <div data-galeria-fuente>
        <GaleriaDiapositivas fotos={fotos} />
      </div>
    </Container>
  </section>
</Base>
