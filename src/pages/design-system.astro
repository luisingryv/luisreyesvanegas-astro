---
import Badge from '../components/brand/Badge.astro';
import Button from '../components/brand/Button.astro';
import Card from '../components/brand/Card.astro';
import Eyebrow from '../components/brand/Eyebrow.astro';
import Metric from '../components/brand/Metric.astro';
import PhotoCard from '../components/brand/PhotoCard.astro';
import Section from '../components/brand/Section.astro';
import SectionHeader from '../components/brand/SectionHeader.astro';
import Base from '../layouts/Base.astro';
import tokens from '../../referencia/tokens-luis-reyes.json';
import fotoEquipo from '../assets/fotos/equipo_2025-09-01_evolutecc-aniversario-5_027.jpg';
import fotoQuito from '../assets/fotos/evento_2025-11-28_cursor-meetup-quito_luis-reyes-vanegas_001.jpg';
import fotoLima from '../assets/fotos/evento_2025-08-29_gdg-summit-latam-2025-lima_luis-reyes-vanegas_001.jpg';

// Página de desarrollo: no se publica.
if (import.meta.env.PROD) return new Response(null, { status: 404 });

const colores = tokens.color.tokens.flatMap((t) =>
  typeof t.value === 'string' && t.value.startsWith('#') ? [{ name: t.name, hex: t.value }] : [],
);
---

<Base locale="es" title="Sistema de diseño">
  <Section tone="light">
    <SectionHeader
      level={1}
      eyebrow="Sistema de diseño"
      title="Componentes de marca"
      lead="Cada bloque de esta página usa los componentes de src/components/brand con los tokens."
    />

    <div class="flex flex-col gap-3">
      <Eyebrow>Eyebrow</Eyebrow>
      <p class="text-display font-bold">Display</p>
      <p class="text-heading font-bold">Heading</p>
      <p class="text-lead text-ink-muted">Lead · bajada de sección</p>
      <p class="text-body">Body · texto corrido</p>
      <p class="text-body font-light text-ink-muted">Body light · texto de apoyo</p>
      <p class="text-caption text-ink-muted">Caption · pies de foto</p>
    </div>

    <ul class="mt-12 grid grid-cols-[repeat(auto-fill,minmax(140px,1fr))] gap-3">
      {colores.map((c) => (
        <li class="overflow-hidden rounded-sm border border-hairline">
          <div class="h-16" style={`background: var(--color-${c.name})`} />
          <div class="bg-surface-raised px-2 py-1.5 text-caption">
            <span class="block font-bold break-all">{c.name}</span>
            <span class="text-ink-muted">{c.hex}</span>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="dark">
    <SectionHeader eyebrow="Section · dark" title="Botones, insignias y cifras">
      <Button slot="action" href="#" variant="secondary">
        Acción a la derecha
      </Button>
    </SectionHeader>
    <div class="flex flex-wrap gap-3">
      <Button href="#">Principal</Button>
      <Button href="#" variant="secondary">
        Secundario
      </Button>
      <Button href="#" variant="secondary" external>
        Externo
      </Button>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <Badge>Obtenida</Badge>
      <Badge tone="soft">En proceso</Badge>
      <Metric size="chip" value="400+" label="proyectos" />
      <Metric size="chip" value="90%" label="de recompra" />
    </div>
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      <Metric
        value="Top 100"
        label="entre 26.449 equipos del Build with Gemini XPRIZE"
        source={{ text: 'gxp.moonshots.com', href: 'https://gxp.moonshots.com/' }}
      />
      <Metric
        value="US$10.000 → US$4.000"
        label="al mes en Google Cloud"
        source={{ text: 'UTPN, 2025' }}
      />
    </div>
  </Section>

  <Section tone="dark-raised">
    <SectionHeader eyebrow="Section · dark-raised" title="Tarjetas sobre blue-800" />
    <ul class="grid gap-4 md:grid-cols-3">
      {['01', '02', '03'].map((n) => (
        <Card as="li" tone="surface">
          <Eyebrow as="span">{n}</Eyebrow>
          <p class="text-body">Card con tono surface, como en "Cómo trabajo".</p>
        </Card>
      ))}
    </ul>
  </Section>

  <Section tone="light">
    <SectionHeader eyebrow="Section · light" title="Tarjetas sobre blanco" />
    <ul class="grid gap-4 md:grid-cols-3">
      <Card as="li">
        <Badge>Obtenida</Badge>
        <p class="text-body font-bold">Card raised</p>
        <p class="text-caption text-ink-muted">Radio lg (24 px)</p>
      </Card>
      <Card as="li" radius="md">
        <Badge tone="soft">En curso</Badge>
        <p class="text-body font-bold">Card raised</p>
        <p class="text-caption text-ink-muted">Radio md (20 px)</p>
      </Card>
      <Card as="li" tone="brand">
        <Eyebrow as="span">Brand</Eyebrow>
        <p class="text-body font-bold">Card brand</p>
        <p class="text-caption text-ink-muted">Fondo blue-500</p>
      </Card>
    </ul>
  </Section>

  <Section tone="dark" separator>
    <SectionHeader eyebrow="Section · dark con separador" title="PhotoCard 4:3 sin recorte" />
    <div class="grid gap-6 md:grid-cols-3">
      <PhotoCard
        image={fotoEquipo}
        alt="Equipo de EvolutecC con camisetas de la marca en el quinto aniversario de la empresa"
        meta="Variante plain · foto 3:2"
        title="Sobra poco espacio arriba y abajo"
        sizes="(min-width: 768px) 33vw, 100vw"
      />
      <PhotoCard
        variant="card"
        image={fotoQuito}
        alt="Asistentes al Cursor meetup en Quito"
        meta="Variante card · foto vertical"
        title="El relleno es la misma foto desenfocada"
        titleAs="h3"
        sizes="(min-width: 768px) 33vw, 100vw"
      />
      <PhotoCard
        image={fotoLima}
        alt="Luis Reyes con integrantes de GDG en el GDG Summit Latam 2025, Lima"
        sizes="(min-width: 768px) 33vw, 100vw"
      />
    </div>
  </Section>

  <Section tone="brand">
    <h2 class="text-heading font-bold">Section · brand</h2>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="#">Principal en blanco</Button>
      <Button href="#" variant="secondary">
        Secundario
      </Button>
    </div>
  </Section>
</Base>
