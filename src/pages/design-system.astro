---
import Base from '../layouts/Base.astro';
import tokens from '../../referencia/tokens-luis-reyes.json';

const colores = tokens.color.tokens.flatMap((t) =>
  typeof t.value === 'string' && t.value.startsWith('#') ? [{ name: t.name, hex: t.value }] : [],
);
---

<Base locale="es" title="Sistema de diseño">
  <style>
    .ds-page {
      max-width: var(--width-container);
      margin-inline: auto;
      padding-inline: var(--spacing-gutter);
      padding-block: 48px;
    }
    .ds-section {
      margin-block-end: 64px;
    }
    .ds-h1 {
      font-size: var(--text-display);
      line-height: var(--text-display--line-height);
      letter-spacing: var(--text-display--letter-spacing);
      font-weight: 700;
      margin-block-end: 8px;
    }
    .ds-h2 {
      font-size: var(--text-heading);
      line-height: var(--text-heading--line-height);
      font-weight: 700;
      margin-block: 48px 24px;
    }
    .ds-eyebrow {
      font-size: var(--text-eyebrow);
      line-height: var(--text-eyebrow--line-height);
      letter-spacing: var(--text-eyebrow--letter-spacing);
      font-weight: 700;
      text-transform: uppercase;
      color: var(--color-link);
      margin-block-end: 12px;
    }
    .ds-lead {
      font-size: var(--text-lead);
      line-height: var(--text-lead--line-height);
      font-weight: 400;
      color: var(--color-ink-muted);
    }
    .ds-caption {
      font-size: var(--text-caption);
      line-height: var(--text-caption--line-height);
      color: var(--color-ink-muted);
    }

    .color-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 12px;
    }
    .color-swatch {
      border-radius: var(--radius-sm);
      overflow: hidden;
      border: 1px solid var(--color-hairline);
    }
    .color-swatch__block {
      block-size: 64px;
    }
    .color-swatch__label {
      padding: 6px 8px;
      font-size: 11px;
      line-height: 1.4;
      background: var(--color-surface-raised);
    }
    .color-swatch__name {
      font-weight: 700;
      display: block;
      overflow-wrap: anywhere;
    }
    .color-swatch__hex {
      color: var(--color-ink-muted);
    }

    .btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 24px;
      border-radius: var(--radius-pill);
      font-family: var(--font-sans);
      font-size: 1rem;
      font-weight: 700;
      line-height: 1;
      text-decoration: none;
      border: 2px solid transparent;
      transition:
        background-color 150ms,
        color 150ms,
        border-color 150ms;
    }
    .btn-primary {
      background: var(--color-primary);
      color: var(--color-on-primary);
    }
    .btn-primary:hover {
      background: var(--color-blue-600);
    }
    .btn-secondary {
      background: transparent;
      color: var(--color-ink);
      border-color: var(--color-ink);
    }
    .btn-secondary:hover {
      background: var(--color-surface-raised);
    }
    .btn-ghost {
      background: transparent;
      color: var(--color-link);
      border-color: var(--color-link);
    }
    .btn-ghost:hover {
      background: var(--color-blue-200);
    }

    .card-row {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
    }
    .card {
      flex: 1 1 240px;
      background: var(--color-surface-raised);
      border-radius: var(--radius-lg);
      padding: 24px;
    }
    .metric {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--color-primary);
      line-height: 1;
    }

    .section-sep {
      border: none;
      border-block-start: 1px solid var(--color-hairline);
      margin-block: var(--spacing-section-y);
    }

    .ds-dark-bg {
      background: var(--color-surface);
      color: var(--color-ink);
      border-radius: var(--radius-lg);
      padding: 32px;
      margin-block-end: 24px;
    }
    .ds-dark-bg .ds-lead {
      color: var(--color-text-secondary-on-dark);
    }
    .ds-dark-bg .ds-caption {
      color: var(--color-text-tertiary-on-dark);
    }
    .ds-dark-bg .card {
      background: var(--color-surface-raised);
    }
    .ds-dark-bg .metric {
      color: var(--color-link);
    }
    .ds-dark-bg .btn-secondary {
      color: var(--color-white);
      border-color: var(--color-white);
    }
    .ds-dark-bg .btn-secondary:hover {
      background: var(--color-blue-800);
    }
  </style>

  <main class="ds-page">
    <p class="ds-eyebrow">Sistema de diseño</p>
    <h1 class="ds-h1">Luis Reyes · Paso 2</h1>
    <p class="ds-lead">Human Sans incrustada · tokens de color · tipografía · radios · botones.</p>

    <hr class="section-sep" />

    <section class="ds-section">
      <h2 class="ds-h2">Tipografía</h2>
      <p class="ds-eyebrow">Eyebrow · 12px · 700 · 0.12em</p>
      <p class="ds-h1">Display · 700</p>
      <p class="ds-h2" style="margin-block:12px 0;">Heading · 700</p>
      <p class="ds-lead">Lead · 400 · Fundé mi primer negocio a los 16.</p>
      <p>Body · 400 · 16px · Texto corrido con Human Sans regular.</p>
      <p style="font-weight:300;color:var(--color-ink-muted);">
        Body light · 300 · Texto de apoyo.
      </p>
      <p class="ds-caption">Caption · 400 · 13px · Pies de foto y metadatos.</p>

      <div class="ds-dark-bg" data-theme="dark" style="margin-block-start:32px;">
        <p class="ds-eyebrow">Sobre fondo night</p>
        <p class="ds-h1">Display blanco</p>
        <p class="ds-lead">text-secondary-on-dark · texto secundario.</p>
        <p class="ds-caption">text-tertiary-on-dark · texto terciario.</p>
      </div>
    </section>

    <section class="ds-section">
      <h2 class="ds-h2">Colores</h2>
      <div class="color-grid">
        {
          colores.map((c) => (
            <div class="color-swatch">
              <div class="color-swatch__block" style={`background:var(--color-${c.name});`} />
              <div class="color-swatch__label">
                <span class="color-swatch__name">{c.name}</span>
                <span class="color-swatch__hex">{c.hex}</span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="ds-section">
      <h2 class="ds-h2">Botones</h2>
      <div class="btn-row">
        <a href="#" class="btn btn-primary">Hablemos</a>
        <a href="#" class="btn btn-secondary">Invitarme a hablar</a>
        <a href="#" class="btn btn-ghost">Enlace secundario →</a>
      </div>
      <div class="ds-dark-bg" data-theme="dark" style="margin-block-start:24px;">
        <div class="btn-row">
          <a href="#" class="btn btn-primary">Hablemos</a>
          <a href="#" class="btn btn-secondary">Invitarme a hablar</a>
        </div>
      </div>
    </section>

    <section class="ds-section">
      <h2 class="ds-h2">Tarjetas · radios · cifras</h2>
      <div class="card-row">
        <div class="card">
          <p class="ds-eyebrow">Cifra</p>
          <p class="metric">400+</p>
          <p class="ds-caption">proyectos con EvolutecC</p>
        </div>
        <div class="card">
          <p class="ds-eyebrow">Cifra</p>
          <p class="metric">90%</p>
          <p class="ds-caption">de recompra</p>
        </div>
      </div>
      <div class="ds-dark-bg" data-theme="dark" style="margin-block-start:16px;">
        <div class="card-row">
          <div class="card">
            <p class="ds-eyebrow">Cifra en oscuro</p>
            <p class="metric">26.449</p>
            <p class="ds-caption">equipos en el XPRIZE</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ds-section">
      <h2 class="ds-h2">Separador de sección</h2>
      <p class="ds-caption">El hairline separa secciones y bordes. Nunca va bajo un título.</p>
      <hr class="section-sep" />
    </section>
  </main>
</Base>
