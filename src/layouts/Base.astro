---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import ogEs from '../assets/og/og-es.png';
import Footer from '../components/brand/Footer.astro';
import Header from '../components/brand/Header.astro';
import Reveal from '../components/motion/Reveal.astro';
import { defaultLocale, publishedLocales, type PublishedLocale } from '../i18n/config';
import { getDictionary } from '../i18n';
import { localizedPath, type RouteKey } from '../i18n/routes';

interface Props {
  locale: PublishedLocale;
  title: string;
  description?: string;
  route?: RouteKey;
  /** Imagen para compartir (1200 × 630). Por defecto, la tarjeta de marca del idioma. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** profile para Sobre mí; article para noticias y casos. */
  type?: 'website' | 'profile' | 'article';
  /** Ancla propia de "Agendar sesión" (ver Header). */
  agendaLocal?: string;
  /** Header mínimo de landing (ver Header). */
  headerMinimo?: { texto: string; href: string };
  /** Botón de la derecha del header propio de la página (ver Header). */
  headerCta?: { texto: string; href: string };
  /** Tema del header: claro en páginas claras (Legal). */
  tema?: 'dark' | 'light';
}

// Tarjetas generadas con scripts/og/generar.mjs (una por idioma publicado).
const ogPorIdioma: Record<PublishedLocale, ImageMetadata> = { es: ogEs };
const ogLocale: Record<PublishedLocale, string> = { es: 'es_LA' };

const {
  locale,
  title,
  description,
  route,
  image,
  imageAlt,
  type = 'website',
  agendaLocal,
  headerMinimo,
  headerCta,
  tema,
} = Astro.props;
const t = getDictionary(locale);
const absolute = (path: string) => new URL(path, Astro.site).toString();
const fullTitle = `${title} · ${t.meta.siteName}`;
const pageUrl = route ? absolute(localizedPath(locale, route)) : undefined;
const og = await getImage({
  src: image ?? ogPorIdioma[locale],
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 85,
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={absolute(og.src)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/HumanSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/HumanSans-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {route && (
      <>
        <link rel="canonical" href={pageUrl} />
        {publishedLocales.map((code) => (
          <link rel="alternate" hreflang={code} href={absolute(localizedPath(code, route))} />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={absolute(localizedPath(defaultLocale, route))}
        />
      </>
    )}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-pill focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary"
    >
      {t.a11y.skipToContent}
    </a>
    <Header
      locale={locale}
      route={route}
      agendaLocal={agendaLocal}
      minimo={headerMinimo}
      cta={headerCta}
      tema={tema}
    />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <Reveal />
    <script>
      // Guarda las UTM con las que llega la visita para enviarlas con el formulario.
      import { guardarUtmDeLaUrl } from '../lib/utm';

      guardarUtmDeLaUrl();
    </script>
  </body>
</html>
