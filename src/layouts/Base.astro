---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import ogEn from '../assets/og/og-en.png';
import ogEs from '../assets/og/og-es.png';
import ogPt from '../assets/og/og-pt.png';
import Footer from '../components/brand/Footer.astro';
import WhatsappFlotante from '../components/brand/WhatsappFlotante.astro';
import Header from '../components/brand/Header.astro';
import Reveal from '../components/motion/Reveal.astro';
import { datosLegales, legalPublicable } from '../config/legal';
import { whatsapp } from '../config/site';
import { defaultLocale, publishedLocales, type Locale, type PublishedLocale } from '../i18n/config';
import { getDictionary } from '../i18n';
import { localizedPath, type RouteKey } from '../i18n/routes';
import { getServicio } from '../lib/content';
import { grafoDelSitio, serializeJsonLd } from '../lib/structured-data';

interface Props {
  locale: PublishedLocale;
  title: string;
  description?: string;
  route?: RouteKey;
  /**
   * Ruta propia sin idioma ("casos/mandaos", "noticias/x") para las páginas dinámicas: manda en
   * canonical, og:url y hreflang. `route` sigue marcando la sección del menú (21 nov 2026).
   */
  ruta?: string;
  /**
   * Idiomas en los que existe esta página. Por defecto, todos los publicados. Una noticia escrita
   * solo en español lleva ['es']: los otros idiomas no la anuncian en hreflang y el selector lleva
   * a su inicio (22 nov 2026).
   */
  idiomas?: readonly PublishedLocale[];
  /** Página que no debe indexarse (borradores, listas vacías). */
  noindex?: boolean;
  /** Imagen para compartir (1200 × 630). Por defecto, la tarjeta de marca del idioma. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** profile para Sobre mí; article para noticias y casos. */
  type?: 'website' | 'profile' | 'article';
  /** Ancla propia de "Agendar sesión" (ver Header). */
  agendaLocal?: string;
  /** Header mínimo de landing (ver Header). */
  headerMinimo?: { texto: string; href: string };
  /** Botón de la derecha del header propio de la página (ver Header). */
  headerCta?: { texto: string; href: string };
  /** Tema del header: claro en páginas claras (Legal). */
  tema?: 'dark' | 'light';
}

// Tarjetas generadas con scripts/og/generar.mjs (una por idioma publicado).
const ogPorIdioma: Record<PublishedLocale, ImageMetadata> = { es: ogEs, en: ogEn, pt: ogPt };
const ogLocale: Record<Locale, string> = { es: 'es_LA', en: 'en_US', pt: 'pt_BR' };

const {
  locale,
  title,
  description,
  route,
  ruta,
  idiomas = publishedLocales,
  noindex = false,
  image,
  imageAlt,
  type = 'website',
  agendaLocal,
  headerMinimo,
  headerCta,
  tema,
} = Astro.props;
const t = getDictionary(locale);
const absolute = (path: string) => new URL(path, Astro.site).toString();
const fullTitle = `${title} · ${t.meta.siteName}`;
const rutaDe = (code: Locale) => (ruta ? `/${code}/${ruta}` : route && localizedPath(code, route));
const pageUrl = rutaDe(locale) ? absolute(rutaDe(locale)!) : undefined;
// El selector lleva a esta página en cada idioma, o al inicio de los idiomas donde no existe.
const alternos = Object.fromEntries(
  publishedLocales.map((code) => {
    const ruta = idiomas.includes(code) ? rutaDe(code) : undefined;
    return [code, ruta || localizedPath(code, 'home')];
  }),
) as Record<PublishedLocale, string>;
const porDefecto = idiomas.includes(defaultLocale) ? defaultLocale : locale;
// Datos estructurados y enlaces para buscadores y agentes de IA (26 nov 2026).
const enlace = (ruta: RouteKey) => absolute(localizedPath(locale, ruta));
const sesion = await getServicio('sesion-de-arquitectura', locale);
const grafo = grafoDelSitio({
  sitio: Astro.site!,
  idioma: locale,
  idiomas: publishedLocales,
  nombreDelSitio: t.meta.siteName,
  cargo: t.pages.home.title,
  urls: {
    inicio: enlace('home'),
    sobreMi: enlace('sobreMi'),
    contacto: enlace('contacto'),
    sesion: enlace('sesionArquitectura'),
  },
  nombres: { sobreMi: t.nav.sobreMi, contacto: t.pages.contacto.title },
  sesion: {
    nombre: sesion.titulo,
    descripcion: sesion.hero.texto,
    textoConPrecio: sesion.entregables.titulo,
  },
  telefono: whatsapp && `+${whatsapp.numero.replace(/\D/g, '')}`,
  correoLegal: legalPublicable ? datosLegales.correoContacto : undefined,
});
const esInicio = route === 'home' && !ruta;
// Herramientas WebMCP (ver script al final): el Home en Markdown y las páginas que se pueden abrir.
const paginasParaAgentes: RouteKey[] = [
  'home',
  'consultoria',
  'sesionArquitectura',
  'adopcionIa',
  'programasAws',
  'productos',
  'casos',
  'eventos',
  'speaker',
  'prensa',
  'sobreMi',
  'cv',
  'contacto',
];
const datosAgentes = {
  idioma: locale,
  idiomas: publishedLocales,
  paginas: Object.fromEntries(paginasParaAgentes.map((r) => [r, localizedPath(locale, r)])),
};
const og = await getImage({
  src: image ?? ogPorIdioma[locale],
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 85,
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={absolute(og.src)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/HumanSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/HumanSans-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="author" href={enlace('sobreMi')} />
    {legalPublicable && (
      <>
        <link rel="privacy-policy" href={enlace('privacidad')} />
        <link rel="terms-of-service" href={enlace('terminos')} />
      </>
    )}
    {esInicio && <link rel="alternate" type="text/markdown" href={absolute(`/${locale}.md`)} />}
    <script type="application/ld+json" set:html={serializeJsonLd(grafo)} />
    {pageUrl && !noindex && (
      <>
        <link rel="canonical" href={pageUrl} />
        {idiomas.map((code) => (
          <link rel="alternate" hreflang={code} href={absolute(rutaDe(code)!)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={absolute(rutaDe(porDefecto)!)} />
      </>
    )}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-pill focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary"
    >
      {t.a11y.skipToContent}
    </a>
    <Header
      locale={locale}
      route={route}
      agendaLocal={agendaLocal}
      minimo={headerMinimo}
      cta={headerCta}
      tema={tema}
      alternos={alternos}
    />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsappFlotante />
    <Reveal />
    <script>
      // Guarda las UTM con las que llega la visita para enviarlas con el formulario.
      import { guardarUtmDeLaUrl } from '../lib/utm';

      guardarUtmDeLaUrl();
    </script>
    <script type="application/json" id="datos-agentes" set:html={serializeJsonLd(datosAgentes)} />
    <script>
      import { registrarHerramientas } from '../lib/webmcp';

      registrarHerramientas();
    </script>
  </body>
</html>
