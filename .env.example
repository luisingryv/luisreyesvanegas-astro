# Copia este archivo a .env y completa los valores. .env no se sube al repositorio.

# ─── Base de datos ──────────────────────────────────────────
# Local: MariaDB 10.11 en Docker (docker compose up -d). Producción: base MariaDB de Hostinger.
# Formato: mysql://usuario:contraseña@host:3306/base
DATABASE_URL=
# Solo pruebas de integración (pnpm test:db): misma conexión, base luisreyes_test.
DATABASE_URL_TEST=
# Solo Docker local: contraseñas que usa docker-compose.yml al crear la base.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# ─── Resend (correo transaccional) ──────────────────────────
RESEND_API_KEY=

# ─── Notion (CRM) ───────────────────────────────────────────
NOTION_API_KEY=
NOTION_DATABASE_ID_CONTACTS=

# ─── Google Calendar (página de reservas) ───────────────────
CALENDAR_BOOKING_URL=

# ─── Sitio ──────────────────────────────────────────────────
SITE_URL=
