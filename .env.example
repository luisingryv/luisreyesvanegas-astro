# Copia este archivo a .env y completa los valores. .env no se sube al repositorio.

# ─── Base de datos ──────────────────────────────────────────
# Local: MariaDB 10.11 en Docker (docker compose up -d). Producción: base MariaDB de Hostinger.
# Formato: mysql://usuario:contraseña@host:3306/base
DATABASE_URL=
# Solo pruebas de integración (pnpm test:db): misma conexión, base luisreyes_test.
DATABASE_URL_TEST=
# Solo Docker local: contraseñas que usa docker-compose.yml al crear la base.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# ─── Resend (aviso por correo de cada solicitud) ────────────
RESEND_API_KEY=
# Correo donde Luis recibe los avisos (nunca aparece en el sitio).
AVISO_CORREO_DESTINO=
# Remitente en el dominio verificado en Resend, p. ej. "Sitio <avisos@dominio>".
AVISO_CORREO_REMITENTE=

# ─── Notion (CRM) ───────────────────────────────────────────
NOTION_API_KEY=
NOTION_DATABASE_ID_CONTACTS=

# ─── Tareas programadas ─────────────────────────────────────
# Token que envía el cron de Hostinger a /api/tareas/sincronizar (reintenta CRM y avisos).
TAREAS_TOKEN=

# ─── WhatsApp corporativo ───────────────────────────────────
# Número con indicativo, p. ej. +57 300 000 0000. Sin valor, la línea no aparece.
WHATSAPP_NUMERO=

# ─── Google Calendar (página de reservas) ───────────────────
CALENDAR_BOOKING_URL=

# ─── Sitio ──────────────────────────────────────────────────
SITE_URL=
